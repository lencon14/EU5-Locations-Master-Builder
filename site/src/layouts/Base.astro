---
import { type Lang, DEFAULT_LANG, LANG_CODES, getHreflang, localePath } from "../i18n/config";
import { t } from "../i18n/ui";
import LangSwitcher from "../components/LangSwitcher.astro";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path portion after /{lang}/eu5 — e.g. "/goods/horses/" */
  canonicalPath?: string;
  wide?: boolean;
  /** If true, use title as-is without appending the suffix */
  fullTitle?: boolean;
}

const { lang, title, description, canonicalPath, wide = false, fullTitle: isFullTitle = false } = Astro.props;
const siteUrl = Astro.site?.origin ?? '';
const hasSiteUrl = siteUrl !== '';
const fullTitle = isFullTitle ? title : `${title} | ${t(lang, 'meta.title_suffix')}`;
const metaDesc = description ?? t(lang, 'site.description');
const canonical = (canonicalPath && hasSiteUrl) ? `${siteUrl}${localePath(lang, canonicalPath)}` : undefined;
---

<html lang={getHreflang(lang)}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonicalPath && hasSiteUrl && LANG_CODES.map((l) => (
      <link rel="alternate" hreflang={getHreflang(l)} href={`${siteUrl}${localePath(l, canonicalPath)}`} />
    ))}
    {canonicalPath && hasSiteUrl && (
      <link rel="alternate" hreflang="x-default" href={`${siteUrl}${localePath(DEFAULT_LANG, canonicalPath)}`} />
    )}
    <style is:global>
      :root {
        /* Surface */
        --deep-obsidian: #0d0f14;
        --dark-walnut: #161a23;
        --charred-oak: #1e2330;
        --slate: #2a3042;

        /* Accent */
        --royal-gold: #c9a84c;
        --pale-gold: #e8d5a3;
        --parchment: #f0e6d0;

        /* Text */
        --ivory: #e8e4dc;
        --dusty-silver: #9a9bab;
        --dim-stone: #5c5f72;

        /* Border */
        --iron-edge: #2e3447;
        --gold-thread: rgba(201, 168, 76, 0.3);

        /* Semantic */
        --crest-red: #c44f4f;
        --forest-green: #4c9a5a;
        --azure-banner: #4a8ec9;
        --harvest-amber: #c9944c;

        /* Typography */
        --font-display: "Cinzel", "Cormorant Garamond", Georgia, serif;
        --font-body: "Inter", "Helvetica Neue", Arial, "Hiragino Kaku Gothic ProN",
          "Hiragino Sans", Meiryo, sans-serif;

        /* Type Scale */
        --type-display: 2.5rem;   /* Hero titles */
        --type-h1: 2rem;          /* Page headings */
        --type-h1-compact: 1.75rem; /* Constrained page heading */
        --type-h2: 1.25rem;       /* Section headings */
        --type-h3: 1.15rem;       /* Card/group headings */
        --type-body: 1rem;        /* Body text, table cells, labels */
        --type-tag: 0.8rem;       /* Tags, badges, tooltips */
        --type-sm: 0.75rem;       /* Small text, chips */
        --type-tiny: 0.7rem;      /* Tiny annotations */
        --type-micro: 0.65rem;    /* Micro labels */
        --type-nano: 0.6rem;      /* Smallest text */
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-body);
        background: var(--deep-obsidian);
        color: var(--ivory);
        line-height: 1.7;
        font-size: 1rem;
      }

      a {
        color: var(--azure-banner);
        text-decoration: none;
      }

      a:hover {
        color: var(--pale-gold);
        text-decoration: underline;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        letter-spacing: 0.03em;
        line-height: 1.3;
        color: var(--ivory);
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a href={localePath(lang)} class="site-title">{t(lang, 'site.title')}</a>
        <ul>
          <li><a href={localePath(lang, '/goods/')}>{t(lang, 'nav.goods')}</a></li>
          <li><a href={localePath(lang, '/buildings/')}>{t(lang, 'nav.buildings')}</a></li>
          <li><a href={localePath(lang, '/countries/')}>{t(lang, 'nav.countries')}</a></li>
          <li><a href={localePath(lang, '/governments/')}>{t(lang, 'nav.governments')}</a></li>
          <li class="nav-dropdown" data-nav-dropdown>
            <a href={localePath(lang, '/religions/')} class="nav-dropdown-trigger">
              {t(lang, 'nav.religions')}
              <svg class="nav-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M2.5 3.75L5 6.25L7.5 3.75" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <div class="nav-dropdown-panel">
              <a href={localePath(lang, '/religions/')} class="nav-dropdown-item">{t(lang, 'nav.religions')}</a>
              <a href={localePath(lang, '/holy-sites/')} class="nav-dropdown-item">{t(lang, 'nav.holy_sites')}</a>
              <a href={localePath(lang, '/aspects/')} class="nav-dropdown-item">{t(lang, 'nav.aspects')}</a>
            </div>
          </li>
        </ul>
        <LangSwitcher lang={lang} currentPath={canonicalPath} />
      </nav>
    </header>
    <main class={wide ? "wide" : ""}>
      <slot />
    </main>
    <script>
      // Nav dropdown: hover (desktop) + click (mobile) + keyboard
      document.querySelectorAll<HTMLElement>("[data-nav-dropdown]").forEach((dd) => {
        const trigger = dd.querySelector<HTMLAnchorElement>(".nav-dropdown-trigger");
        if (!trigger) return;
        let hideTimer: ReturnType<typeof setTimeout>;

        function show() {
          clearTimeout(hideTimer);
          dd.classList.add("is-open");
        }
        function hide() {
          hideTimer = setTimeout(() => dd.classList.remove("is-open"), 150);
        }

        // Desktop: hover
        dd.addEventListener("mouseenter", show);
        dd.addEventListener("mouseleave", hide);

        // Mobile: prevent navigation on first tap, toggle dropdown instead
        trigger.addEventListener("click", (e) => {
          if (window.matchMedia("(hover: none)").matches) {
            if (!dd.classList.contains("is-open")) {
              e.preventDefault();
              show();
            }
          }
        });

        // Keyboard
        trigger.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            show();
            dd.querySelector<HTMLAnchorElement>(".nav-dropdown-item")?.focus();
          }
          if (e.key === "Escape") hide();
        });

        dd.querySelector(".nav-dropdown-panel")?.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            hide();
            trigger.focus();
          }
        });

        // Close on outside click
        document.addEventListener("click", (e) => {
          if (!dd.contains(e.target as Node)) dd.classList.remove("is-open");
        });
      });
    </script>
    <footer>
      <div class="footer-inner">
        <p>{t(lang, 'footer.tagline')}</p>
      </div>
    </footer>
    <style>
      header {
        background: var(--charred-oak);
        border-bottom: 1px solid var(--iron-edge);
        min-height: 56px;
        display: flex;
        align-items: center;
        padding: 0 1.5rem;
        position: sticky;
        top: 0;
        z-index: 20;
      }

      nav {
        max-width: 1440px;
        width: 100%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 2rem;
        flex-wrap: wrap;
        padding: 0.5rem 0;
      }

      @media (max-width: 640px) {
        nav {
          gap: 0.75rem;
        }
        nav ul {
          gap: 0.75rem;
        }
      }

      .site-title {
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--royal-gold);
        letter-spacing: 0.05em;
      }

      .site-title:hover {
        color: var(--pale-gold);
        text-decoration: none;
      }

      nav ul {
        display: flex;
        list-style: none;
        gap: 1.5rem;
      }

      nav ul a {
        color: var(--ivory);
        font-size: var(--type-body);
        font-weight: 500;
        letter-spacing: 0.02em;
      }

      nav ul a:hover {
        color: var(--pale-gold);
        text-decoration: none;
      }

      /* Dropdown nav */
      .nav-dropdown {
        position: relative;
      }

      .nav-dropdown-trigger {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
      }

      .nav-chevron {
        transition: transform 0.2s;
        opacity: 0.6;
        flex-shrink: 0;
      }

      .nav-dropdown.is-open .nav-chevron {
        transform: rotate(180deg);
      }

      .nav-dropdown-panel {
        position: absolute;
        top: calc(100% + 0.5rem);
        left: 50%;
        transform: translateX(-50%);
        min-width: 160px;
        background: var(--dark-walnut);
        border: 1px solid var(--iron-edge);
        border-top: 2px solid var(--royal-gold);
        border-radius: 0 0 4px 4px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        padding: 0.35rem 0;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.15s, transform 0.15s;
        transform: translateX(-50%) translateY(-4px);
        z-index: 30;
      }

      .nav-dropdown.is-open .nav-dropdown-panel {
        opacity: 1;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
      }

      .nav-dropdown-item {
        display: block;
        padding: 0.4rem 1rem;
        color: var(--ivory);
        font-size: var(--type-body);
        font-weight: 500;
        white-space: nowrap;
        transition: background 0.1s;
      }

      .nav-dropdown-item:hover {
        background: var(--slate);
        color: var(--pale-gold);
        text-decoration: none;
      }

      main {
        max-width: 960px;
        margin: 2rem auto;
        padding: 0 1.5rem;
      }

      main.wide {
        max-width: 1440px;
      }

      footer {
        border-top: 1px solid var(--iron-edge);
        margin-top: 3rem;
      }

      .footer-inner {
        max-width: 1440px;
        margin: 0 auto;
        padding: 1.5rem;
        text-align: center;
        color: var(--dim-stone);
        font-size: var(--type-sm);
      }
    </style>
  </body>
</html>
