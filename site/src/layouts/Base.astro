---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} | EU5 攻略DB</title>
    <style is:global>
      :root {
        /* Surface */
        --deep-obsidian: #0d0f14;
        --dark-walnut: #161a23;
        --charred-oak: #1e2330;
        --slate: #2a3042;

        /* Accent */
        --royal-gold: #c9a84c;
        --pale-gold: #e8d5a3;
        --parchment: #f0e6d0;

        /* Text */
        --ivory: #e8e4dc;
        --dusty-silver: #9a9bab;
        --dim-stone: #5c5f72;

        /* Border */
        --iron-edge: #2e3447;
        --gold-thread: rgba(201, 168, 76, 0.3);

        /* Semantic */
        --crest-red: #c44f4f;
        --forest-green: #4c9a5a;
        --azure-banner: #4a8ec9;
        --harvest-amber: #c9944c;

        /* Typography */
        --font-display: "Cinzel", "Cormorant Garamond", Georgia, serif;
        --font-body: "Inter", "Helvetica Neue", Arial, "Hiragino Kaku Gothic ProN",
          "Hiragino Sans", Meiryo, sans-serif;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-body);
        background: var(--deep-obsidian);
        color: var(--ivory);
        line-height: 1.7;
        font-size: 1rem;
      }

      a {
        color: var(--azure-banner);
        text-decoration: none;
      }

      a:hover {
        color: var(--pale-gold);
        text-decoration: underline;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        letter-spacing: 0.03em;
        line-height: 1.3;
        color: var(--ivory);
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="site-title">EU5 攻略DB</a>
        <ul>
          <li><a href="/goods/">交易品</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <p>EU5 攻略DB &mdash; Fan-made guide for Europa Universalis V</p>
      </div>
    </footer>
    <style>
      header {
        background: var(--charred-oak);
        border-bottom: 1px solid var(--iron-edge);
        height: 56px;
        display: flex;
        align-items: center;
        padding: 0 1.5rem;
      }

      nav {
        max-width: 960px;
        width: 100%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 2rem;
      }

      .site-title {
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--royal-gold);
        letter-spacing: 0.05em;
      }

      .site-title:hover {
        color: var(--pale-gold);
        text-decoration: none;
      }

      nav ul {
        display: flex;
        list-style: none;
        gap: 1.5rem;
      }

      nav ul a {
        color: var(--ivory);
        font-size: 0.875rem;
        font-weight: 500;
        letter-spacing: 0.02em;
      }

      nav ul a:hover {
        color: var(--pale-gold);
        text-decoration: none;
      }

      main {
        max-width: 960px;
        margin: 2rem auto;
        padding: 0 1.5rem;
      }

      footer {
        border-top: 1px solid var(--iron-edge);
        margin-top: 3rem;
      }

      .footer-inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 1.5rem;
        text-align: center;
        color: var(--dim-stone);
        font-size: 0.75rem;
      }
    </style>
  </body>
</html>
