---
import { type Lang, DEFAULT_LANG, LANG_CODES, getHreflang, localePath } from "../i18n/config";
import { t } from "../i18n/ui";
import LangSwitcher from "../components/LangSwitcher.astro";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path portion after /{lang}/eu5 — e.g. "/goods/horses/" */
  canonicalPath?: string;
  wide?: boolean;
  /** If true, use title as-is without appending the suffix */
  fullTitle?: boolean;
}

const { lang, title, description, canonicalPath, wide = false, fullTitle: isFullTitle = false } = Astro.props;
const siteUrl = Astro.site?.origin ?? '';
const hasSiteUrl = siteUrl !== '';
const fullTitle = isFullTitle ? title : `${title} | ${t(lang, 'meta.title_suffix')}`;
const metaDesc = description ?? t(lang, 'site.description');
const canonical = (canonicalPath && hasSiteUrl) ? `${siteUrl}${localePath(lang, canonicalPath)}` : undefined;
---

<html lang={getHreflang(lang)}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonicalPath && hasSiteUrl && LANG_CODES.map((l) => (
      <link rel="alternate" hreflang={getHreflang(l)} href={`${siteUrl}${localePath(l, canonicalPath)}`} />
    ))}
    {canonicalPath && hasSiteUrl && (
      <link rel="alternate" hreflang="x-default" href={`${siteUrl}${localePath(DEFAULT_LANG, canonicalPath)}`} />
    )}
    <style is:global>
      :root {
        /* Surface */
        --deep-obsidian: #0d0f14;
        --dark-walnut: #161a23;
        --charred-oak: #1e2330;
        --slate: #2a3042;

        /* Accent */
        --royal-gold: #c9a84c;
        --pale-gold: #e8d5a3;
        --parchment: #f0e6d0;

        /* Text */
        --ivory: #e8e4dc;
        --dusty-silver: #9a9bab;
        --dim-stone: #5c5f72;

        /* Border */
        --iron-edge: #2e3447;
        --gold-thread: rgba(201, 168, 76, 0.3);

        /* Semantic */
        --crest-red: #c44f4f;
        --forest-green: #4c9a5a;
        --azure-banner: #4a8ec9;
        --harvest-amber: #c9944c;

        /* Typography */
        --font-display: "Cinzel", "Cormorant Garamond", Georgia, serif;
        --font-body: "Inter", "Helvetica Neue", Arial, "Hiragino Kaku Gothic ProN",
          "Hiragino Sans", Meiryo, sans-serif;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-body);
        background: var(--deep-obsidian);
        color: var(--ivory);
        line-height: 1.7;
        font-size: 1rem;
      }

      a {
        color: var(--azure-banner);
        text-decoration: none;
      }

      a:hover {
        color: var(--pale-gold);
        text-decoration: underline;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        letter-spacing: 0.03em;
        line-height: 1.3;
        color: var(--ivory);
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a href={localePath(lang)} class="site-title">{t(lang, 'site.title')}</a>
        <ul>
          <li><a href={localePath(lang, '/goods/')}>{t(lang, 'nav.goods')}</a></li>
          <li><a href={localePath(lang, '/buildings/')}>{t(lang, 'nav.buildings')}</a></li>
        </ul>
        <LangSwitcher lang={lang} currentPath={canonicalPath} />
      </nav>
    </header>
    <main class={wide ? "wide" : ""}>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <p>{t(lang, 'footer.tagline')}</p>
      </div>
    </footer>
    <style>
      header {
        background: var(--charred-oak);
        border-bottom: 1px solid var(--iron-edge);
        height: 56px;
        display: flex;
        align-items: center;
        padding: 0 1.5rem;
        position: sticky;
        top: 0;
        z-index: 20;
      }

      nav {
        max-width: 1440px;
        width: 100%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 2rem;
      }

      .site-title {
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--royal-gold);
        letter-spacing: 0.05em;
      }

      .site-title:hover {
        color: var(--pale-gold);
        text-decoration: none;
      }

      nav ul {
        display: flex;
        list-style: none;
        gap: 1.5rem;
      }

      nav ul a {
        color: var(--ivory);
        font-size: 0.875rem;
        font-weight: 500;
        letter-spacing: 0.02em;
      }

      nav ul a:hover {
        color: var(--pale-gold);
        text-decoration: none;
      }

      main {
        max-width: 960px;
        margin: 2rem auto;
        padding: 0 1.5rem;
      }

      main.wide {
        max-width: 1440px;
      }

      footer {
        border-top: 1px solid var(--iron-edge);
        margin-top: 3rem;
      }

      .footer-inner {
        max-width: 1440px;
        margin: 0 auto;
        padding: 1.5rem;
        text-align: center;
        color: var(--dim-stone);
        font-size: 0.75rem;
      }
    </style>
  </body>
</html>
