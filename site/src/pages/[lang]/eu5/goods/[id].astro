---
import Base from "../../../../layouts/Base.astro";
import { LANG_CODES, type Lang, localePath } from "../../../../i18n/config";
import { loadCore, loadLoc, gameTerm } from "../../../../i18n/data";
import { t } from "../../../../i18n/ui";
import type { GoodsItem } from "../../../../i18n/types";
import allBuildings from "../../../../data/buildings.json";

export function getStaticPaths() {
  const core = loadCore<GoodsItem>("goods");
  return LANG_CODES.flatMap((lang) =>
    core.map((item) => ({
      params: { lang, id: item.id },
      props: { lang, item },
    })),
  );
}

const { lang, item } = Astro.props as { lang: Lang; item: GoodsItem };
const loc = loadLoc("goods", lang);
const locEn = lang !== "en" ? loadLoc("goods", "en") : loc;
const name = loc[item.id]?.name ?? item.id;
const nameEn = locEn[item.id]?.name ?? item.id;
const desc = loc[item.id]?.desc;

/** Get tooltip text for a game term (returns desc if available, else undefined) */
function tip(key: string): string | undefined {
  const d = gameTerm(lang, `${key}.desc`);
  return d !== `${key}.desc` ? d : undefined;
}

// --- Unified POP table: demand + wealth impact ---
const ALL_POP_TYPES = ["nobles", "clergy", "burghers", "laborers", "soldiers", "peasants", "slaves", "tribesmen"] as const;
const UPPER_CLASS = new Set(["nobles", "clergy", "burghers"]);

type PopRow = {
  popId: string;
  base: number;
  multiplier: number;
  final: number;
  wealth: number | null;
};

const popRows: PopRow[] = ALL_POP_TYPES.map((popId) => {
  // Demand
  const add = item.demand_add;
  const mul = item.demand_multiply;
  const base = add?.[popId] ?? (UPPER_CLASS.has(popId) ? add?.["upper"] : undefined) ?? add?.["all"] ?? 0;
  let multiplier = 1;
  if (mul) {
    if (popId in mul) {
      multiplier = mul[popId];
    } else if (UPPER_CLASS.has(popId) && "upper" in mul) {
      multiplier = mul["upper"];
    }
  }
  // Wealth
  const wit = item.wealth_impact_threshold;
  const wealth = wit?.[popId] ?? wit?.["all"] ?? null;
  return { popId, base, multiplier, final: base * multiplier, wealth };
});

// --- Building uses (reverse index: which buildings consume/produce this good) ---
const SPECIAL_KEYS = new Set(["category", "produced", "output", "_name_ja", "_category_ja", "allow", "potential", "debug_max_profit"]);

type BuildingUse = {
  buildingId: string;
  icon: string;
  role: "input" | "output";
};

const useSet = new Set<string>();
const uses: BuildingUse[] = [];
for (const b of allBuildings as any[]) {
  const pm = b.production_methods;
  if (!pm) continue;
  for (const pmData of Object.values(pm) as any[]) {
    // Input: numeric keys that are goods IDs
    if (item.id in pmData && !SPECIAL_KEYS.has(item.id) && typeof pmData[item.id] === "number") {
      const key = `${b.id}:input`;
      if (!useSet.has(key)) { useSet.add(key); uses.push({ buildingId: b.id, icon: b.icon, role: "input" }); }
    }
    // Output: produced field matches this good
    if (pmData.produced === item.id) {
      const key = `${b.id}:output`;
      if (!useSet.has(key)) { useSet.add(key); uses.push({ buildingId: b.id, icon: b.icon, role: "output" }); }
    }
  }
}
// Sort: output first, then alphabetically by building ID
uses.sort((a, b) => {
  if (a.role !== b.role) return a.role === "output" ? -1 : 1;
  return a.buildingId.localeCompare(b.buildingId);
});

/** Get building name for current language */
function bldgName(b: any): string {
  if (lang === "ja") return b.name_ja ?? b.name_en ?? b.id;
  return b.name_en ?? b.id;
}
const bldgMap = new Map((allBuildings as any[]).map((b: any) => [b.id, b]));
---

<Base
  lang={lang}
  title={name}
  description={desc ? `${name} — ${desc.slice(0, 120)}` : undefined}
  canonicalPath={`/goods/${item.id}/`}
>
  <nav class="breadcrumb">
    <a href={localePath(lang, "/goods/")}>{t(lang, "goods.breadcrumb")}</a>
    <span class="sep">&rsaquo;</span>
    <span>{name}</span>
  </nav>

  <header class="good-header">
    <div class="header-title">
      <img src={`/${item.icon}`} alt="" width="48" height="48" class="header-icon" />
      <h1>{name}</h1>
    </div>
    {lang !== "en" && <span class="en-name">{nameEn}</span>}
    <code class="id-badge">{item.id}</code>
  </header>

  <section class="props-card">
    <h2>{t(lang, "common.basic_info")}</h2>
      <dl>
        <div class="prop-row">
          <dt>{t(lang, "common.category")}</dt>
          <dd data-tip={tip(`goods.cat.${item.category}`)}>{gameTerm(lang, `goods.cat.${item.category}`)}</dd>
        </div>
        {
          item.method && (
            <div class="prop-row">
              <dt>{gameTerm(lang, "field.method")}</dt>
              <dd>
                <span class="tag">
                  {gameTerm(lang, `goods.method.${item.method}`)}
                </span>
              </dd>
            </div>
          )
        }
        <div class="prop-row">
          <dt data-tip={tip("field.market_price")}>{gameTerm(lang, "field.default_market_price")}</dt>
          <dd class="num-val">{item.default_market_price}</dd>
        </div>
        {
          item.food != null && (
            <div class="prop-row">
              <dt data-tip={tip("field.food")}>{gameTerm(lang, "field.food")}</dt>
              <dd class="num-val">{item.food}</dd>
            </div>
          )
        }
        {
          item.transport_cost != null && (
            <div class="prop-row">
              <dt data-tip={tip("field.cost")}>{gameTerm(lang, "field.transport_cost")}</dt>
              <dd class="num-val">{item.transport_cost}</dd>
            </div>
          )
        }
        {
          item.base_production != null && (
            <div class="prop-row">
              <dt>{gameTerm(lang, "field.base_production")}</dt>
              <dd class="num-val">{item.base_production}</dd>
            </div>
          )
        }
        {
          item.origin && (
            <div class="prop-row">
              <dt>{gameTerm(lang, "field.origin")}</dt>
              <dd>{gameTerm(lang, `goods.origin.${item.origin}`)}</dd>
            </div>
          )
        }
        {
          item.development_threshold != null && (
            <div class="prop-row">
              <dt data-tip={tip("field.development")}>{gameTerm(lang, "field.development_threshold")}</dt>
              <dd class="num-val">{item.development_threshold}</dd>
            </div>
          )
        }
      </dl>
  </section>

  <section class="panel pop-panel">
      <h3><span data-tip={tip("field.demand")}>POP {gameTerm(lang, "field.demand")}</span> <span class="unit">({t(lang, "goods.per_1000")})</span> &amp; <span data-tip={tip("field.wealth")}>{gameTerm(lang, "field.wealth_impact_threshold")}</span></h3>
      <table>
        <thead>
          <tr>
            <th class="icon-head"></th>
            <th>POP</th>
            <th class="num-head" data-tip={tip("field.demand")}>{gameTerm(lang, "field.demand_add")}</th>
            <th class="num-head">&times;</th>
            <th class="num-head">=</th>
            <th class="num-head sep-left" data-tip={tip("field.wealth")}>{gameTerm(lang, "field.wealth")}</th>
          </tr>
        </thead>
        <tbody>
          {popRows.map((r) => {
            const demandZero = r.final === 0 && r.base === 0;
            const wealthZero = r.wealth === null;
            const allZero = demandZero && wealthZero;
            return (
              <tr class={allZero ? "zero-row" : ""}>
                <td class="icon-cell"><img src={`/icons/pops/${r.popId}.png`} alt="" width="24" height="24" /></td>
                <td data-tip={tip(`pop.${r.popId}`)}>{gameTerm(lang, `pop.${r.popId}`)}</td>
                <td class={`num${!allZero && demandZero ? " dim" : ""}`}>{r.base}</td>
                <td class={`num${!allZero && demandZero ? " dim" : ""}`}>{r.multiplier !== 1 ? `×${r.multiplier}` : ""}</td>
                <td class={`num result${!allZero && demandZero ? " dim" : ""}`}>{r.final}</td>
                <td class={`num sep-left${!allZero && wealthZero ? " dim" : ""}`}>{r.wealth !== null ? r.wealth : "-"}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
  </section>

  {
    uses.length > 0 && (
      <section class="building-uses">
        <h2>{t(lang, "goods.building_uses")} <span class="category-count">{uses.length}</span></h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="icon-head"></th>
                <th>{t(lang, "goods.col.building")}</th>
                <th>{t(lang, "goods.col.role")}</th>
              </tr>
            </thead>
            <tbody>
              {uses.map((u) => {
                const b = bldgMap.get(u.buildingId);
                return (
                  <tr class="bldg-row" data-href={localePath(lang, `/buildings/${u.buildingId}/`)}>
                    <td class="icon-cell">
                      {b?.icon && <img src={`/${b.icon}`} alt="" width="24" height="24" loading="lazy" />}
                    </td>
                    <td>
                      <a href={localePath(lang, `/buildings/${u.buildingId}/`)}>
                        {b ? bldgName(b) : u.buildingId}
                      </a>
                    </td>
                    <td>
                      <span class={`role-tag ${u.role}`}>
                        {t(lang, `goods.role.${u.role}` as any)}
                      </span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    desc && (
      <section class="description">
        <h2>{t(lang, "common.description")}</h2>
        <p>{desc}</p>
      </section>
    )
  }

  <script>
    document.querySelectorAll<HTMLTableRowElement>(".bldg-row").forEach((row) => {
      const href = row.dataset.href;
      if (!href) return;
      row.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a")) return;
        window.location.href = href;
      });
    });
  </script>

  <style>
    .breadcrumb {
      margin-bottom: 1.5rem;
      font-size: var(--type-body);
      color: var(--dusty-silver);
    }

    .breadcrumb .sep {
      margin: 0 0.4rem;
      color: var(--dim-stone);
    }

    .breadcrumb span:last-child {
      color: var(--ivory);
    }

    .good-header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--gold-thread);
    }

    .header-title {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .header-icon {
      image-rendering: pixelated;
    }

    .good-header h1 {
      font-size: var(--type-h1);
      color: var(--royal-gold);
      margin-bottom: 0.25rem;
    }

    .en-name {
      color: var(--dusty-silver);
      font-size: var(--type-body);
      margin-right: 0.75rem;
    }

    .id-badge {
      background: var(--charred-oak);
      border: 1px solid var(--iron-edge);
      border-radius: 2px;
      padding: 0.1rem 0.5rem;
      font-size: var(--type-body);
      color: var(--dim-stone);
    }

    .props-card,
    .panel {
      background: var(--dark-walnut);
      border: 1px solid var(--iron-edge);
      border-radius: 4px;
      padding: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .props-card h2,
    .panel h3 {
      font-size: var(--type-h3);
      font-family: var(--font-body);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--dusty-silver);
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--iron-edge);
    }

    dl {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .prop-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.4rem 0;
      border-bottom: 1px solid var(--iron-edge);
    }

    .prop-row:last-child {
      border-bottom: none;
    }

    dt {
      font-size: var(--type-body);
      color: var(--dusty-silver);
    }

    [data-tip] {
      cursor: help;
      text-decoration: underline dotted var(--dim-stone);
      text-underline-offset: 2px;
      position: relative;
    }

    [data-tip]::after {
      content: attr(data-tip);
      position: absolute;
      left: 0;
      bottom: calc(100% + 8px);
      width: max-content;
      max-width: 320px;
      padding: 0.5rem 0.75rem;
      background: var(--charred-oak);
      border: 1px solid var(--royal-gold);
      border-radius: 4px;
      color: var(--ivory);
      font-family: var(--font-body);
      font-size: var(--type-tag);
      line-height: 1.5;
      white-space: normal;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
      z-index: 50;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.15s;
    }

    [data-tip]:hover::after {
      opacity: 1;
    }

    h3[data-tip] {
      display: inline-block;
    }

    h3[data-tip]::after {
      bottom: auto;
      top: calc(100% + 4px);
    }

    .pop-panel table {
      width: 100%;
      border-collapse: collapse;
    }

    .pop-panel th {
      padding: 0.4rem 0.5rem;
      text-align: left;
      font-size: var(--type-body);
      font-weight: 500;
      color: var(--dusty-silver);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--iron-edge);
    }

    .pop-panel thead {
      background: var(--charred-oak);
    }

    .pop-panel .icon-head {
      width: 32px;
      padding: 0.4rem 0.25rem;
    }

    .pop-panel .icon-cell {
      width: 32px;
      padding: 0.3rem 0.25rem;
      text-align: center;
    }

    .pop-panel .icon-cell img {
      vertical-align: middle;
      image-rendering: pixelated;
    }

    .pop-panel .num-head {
      text-align: right;
    }

    .pop-panel td {
      padding: 0.4rem 0.5rem;
      font-size: var(--type-body);
      border-bottom: 1px solid var(--iron-edge);
    }

    .pop-panel tr:last-child td {
      border-bottom: none;
    }

    .sep-left {
      border-left: 2px solid var(--iron-edge);
      padding-left: 0.75rem !important;
    }

    .result {
      font-weight: 600;
      color: var(--pale-gold);
    }

    .dim {
      opacity: 0.35;
    }

    .zero-row {
      opacity: 0.35;
    }

    .unit {
      font-family: var(--font-body);
      font-size: var(--type-micro);
      font-weight: 400;
      color: var(--dim-stone);
      text-transform: none;
      letter-spacing: normal;
    }

    dd {
      font-size: var(--type-body);
      font-weight: 500;
    }

    .num-val {
      font-variant-numeric: tabular-nums;
    }

    .tag {
      display: inline-block;
      background: rgba(201, 168, 76, 0.15);
      color: var(--pale-gold);
      border-radius: 2px;
      padding: 0.1rem 0.5rem;
      font-size: var(--type-body);
      font-weight: 500;
    }

    .num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .building-uses {
      background: var(--dark-walnut);
      border: 1px solid var(--iron-edge);
      border-radius: 4px;
      padding: 1.25rem;
      margin-bottom: 2rem;
    }

    .building-uses h2 {
      font-size: var(--type-h3);
      font-family: var(--font-body);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--dusty-silver);
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--iron-edge);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .building-uses .category-count {
      font-family: var(--font-body);
      font-size: var(--type-tiny);
      font-weight: 500;
      color: var(--dusty-silver);
      background: var(--slate);
      padding: 0.1rem 0.45rem;
      border-radius: 2px;
    }

    .building-uses .table-wrap {
      overflow-x: auto;
      max-height: 400px;
      overflow-y: auto;
    }

    .building-uses table {
      width: 100%;
      border-collapse: collapse;
    }

    .building-uses thead {
      background: var(--charred-oak);
      position: sticky;
      top: 0;
      z-index: 1;
    }

    .building-uses th {
      padding: 0.4rem 0.75rem;
      text-align: left;
      font-family: var(--font-body);
      font-weight: 500;
      font-size: var(--type-body);
      color: var(--dusty-silver);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--iron-edge);
    }

    .building-uses .num-head {
      text-align: right;
    }

    .building-uses td {
      padding: 0.4rem 0.75rem;
      font-size: var(--type-body);
      border-bottom: 1px solid var(--iron-edge);
    }

    .building-uses .icon-head {
      width: 32px;
      padding: 0.4rem 0.25rem;
    }

    .building-uses .icon-cell {
      width: 32px;
      padding: 0.3rem 0.25rem;
      text-align: center;
    }

    .building-uses .icon-cell img {
      vertical-align: middle;
      image-rendering: pixelated;
    }

    .building-uses .num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .building-uses tr[data-href] {
      cursor: pointer;
    }

    .building-uses tr:hover {
      background: var(--slate);
    }

    .building-uses td a {
      color: var(--ivory);
      font-weight: 500;
    }

    .building-uses td a:hover {
      color: var(--pale-gold);
    }

    .building-uses tr:last-child td {
      border-bottom: none;
    }

    .role-tag {
      display: inline-block;
      border-radius: 2px;
      padding: 0.1rem 0.5rem;
      font-size: var(--type-body);
      font-weight: 500;
    }

    .role-tag.input {
      background: rgba(201, 168, 76, 0.15);
      color: var(--pale-gold);
    }

    .role-tag.output {
      background: rgba(76, 175, 80, 0.15);
      color: #81c784;
    }

    .description {
      background: var(--dark-walnut);
      border: 1px solid var(--iron-edge);
      border-radius: 4px;
      padding: 1.25rem;
    }

    .description h2 {
      font-size: var(--type-h3);
      font-family: var(--font-body);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--dusty-silver);
      margin-bottom: 0.75rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--iron-edge);
    }

    .description p {
      color: var(--dusty-silver);
      font-size: var(--type-body);
      line-height: 1.8;
    }
  </style>
</Base>
