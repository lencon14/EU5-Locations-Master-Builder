---
import Base from "../../../../layouts/Base.astro";
import { LANG_CODES, type Lang, localePath } from "../../../../i18n/config";
import { loadCore, loadLoc, gameTerm } from "../../../../i18n/data";
import { t, tf } from "../../../../i18n/ui";
import type { GoodsItem } from "../../../../i18n/types";

export function getStaticPaths() {
  return LANG_CODES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const core = loadCore<GoodsItem>("goods");
const loc = loadLoc("goods", lang);
const locEn = lang !== "en" ? loadLoc("goods", "en") : loc;

const grouped = new Map<string, GoodsItem[]>();
for (const g of core) {
  const cat = g.category ?? "other";
  if (!grouped.has(cat)) grouped.set(cat, []);
  grouped.get(cat)!.push(g);
}
---

<Base lang={lang} title={t(lang, "goods.title")} canonicalPath="/goods/">
  <h1>{t(lang, "goods.title")}</h1>
  <p class="lead">{tf(lang, "common.items", { count: core.length })}</p>

  <div class="filter-bar">
    <input type="text" id="search" placeholder={t(lang, "common.search")} aria-label={t(lang, "common.search")} />
  </div>

  {
    [...grouped.entries()].map(([category, items]) => (
      <section class="category-section" data-category={category}>
        <h2>
          <span class="category-name">
            {gameTerm(lang, `goods.cat.${category}`)}
          </span>
          <span class="category-count">{items.length}</span>
        </h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="icon-head"></th>
                <th>{t(lang, "goods.col.name")}</th>
                {lang !== "en" && <th>{t(lang, "goods.col.name_en")}</th>}
                <th>{gameTerm(lang, "field.method")}</th>
                <th class="num-head">{gameTerm(lang, "field.default_market_price")}</th>
                <th class="num-head">{gameTerm(lang, "field.transport_cost")}</th>
              </tr>
            </thead>
            <tbody>
              {items.map((g) => {
                const name = loc[g.id]?.name ?? g.id;
                const nameEn = lang !== "en" ? (locEn[g.id]?.name ?? g.id) : "";
                return (
                  <tr
                    class="goods-row"
                    data-name={`${name} ${nameEn} ${g.id}`}
                  >
                    <td class="icon-cell">
                      <img src={`/${g.icon}`} alt="" width="24" height="24" loading="lazy" />
                    </td>
                    <td>
                      <a href={localePath(lang, `/goods/${g.id}/`)}>{name}</a>
                    </td>
                    {lang !== "en" && <td class="muted">{nameEn}</td>}
                    <td>
                      {g.method ? (
                        <span class="tag">
                          {gameTerm(lang, `goods.method.${g.method}`)}
                        </span>
                      ) : (
                        <span class="muted">-</span>
                      )}
                    </td>
                    <td class="num">{g.default_market_price}</td>
                    <td class="num">{g.transport_cost ?? "-"}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  <script>
    const input = document.getElementById("search") as HTMLInputElement;
    const rows = document.querySelectorAll<HTMLTableRowElement>(".goods-row");

    function normalize(s: string): string {
      return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    input.addEventListener("input", () => {
      const q = normalize(input.value);
      rows.forEach((row) => {
        const name = normalize(row.dataset.name || "");
        row.style.display = name.includes(q) ? "" : "none";
      });
      document
        .querySelectorAll<HTMLElement>(".category-section")
        .forEach((sec) => {
          const visible = sec.querySelectorAll(
            '.goods-row:not([style*="display: none"])',
          );
          sec.style.display = visible.length > 0 ? "" : "none";
        });
    });
  </script>

  <style>
    h1 {
      font-size: 2rem;
      margin-bottom: 0.25rem;
    }

    .lead {
      color: var(--dusty-silver);
      margin-bottom: 1.5rem;
    }

    .filter-bar {
      margin-bottom: 2rem;
    }

    #search {
      width: 100%;
      max-width: 400px;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      font-family: var(--font-body);
      background: var(--dark-walnut);
      border: 1px solid var(--iron-edge);
      border-radius: 4px;
      color: var(--ivory);
    }

    #search::placeholder {
      color: var(--dim-stone);
    }

    #search:focus {
      outline: none;
      border-color: var(--royal-gold);
      box-shadow: 0 0 0 2px rgba(201, 168, 76, 0.2);
    }

    .category-section {
      margin-bottom: 3rem;
    }

    .category-section h2 {
      font-size: 1.15rem;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .category-name {
      padding-bottom: 0.25rem;
      border-bottom: 2px solid var(--royal-gold);
    }

    .category-count {
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--dusty-silver);
      background: var(--slate);
      padding: 0.1rem 0.5rem;
      border-radius: 2px;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead {
      background: var(--charred-oak);
    }

    th {
      padding: 0.5rem 0.75rem;
      text-align: left;
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 0.75rem;
      color: var(--dusty-silver);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--iron-edge);
    }

    .num-head {
      text-align: right;
    }

    td {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      border-bottom: 1px solid var(--iron-edge);
    }

    .muted {
      color: var(--dusty-silver);
    }

    .num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .tag {
      display: inline-block;
      background: rgba(201, 168, 76, 0.15);
      color: var(--pale-gold);
      border-radius: 2px;
      padding: 0.1rem 0.5rem;
      font-size: 0.75rem;
      font-weight: 500;
    }

    .icon-head {
      width: 32px;
      padding: 0.5rem 0.25rem;
    }

    .icon-cell {
      width: 32px;
      padding: 0.35rem 0.25rem;
      text-align: center;
    }

    .icon-cell img {
      vertical-align: middle;
      image-rendering: pixelated;
    }

    tr:hover {
      background: var(--slate);
    }

    td a {
      color: var(--ivory);
      font-weight: 500;
    }

    td a:hover {
      color: var(--pale-gold);
    }
  </style>
</Base>
