  <style>
    /* ═══ PAGE LAYOUT ═══ */
    .page-layout {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 1.5rem;
      align-items: start;
    }

    /* ═══ SIDEBAR ═══ */
    .sidebar {
      position: sticky;
      top: 72px;
      max-height: calc(100vh - 88px);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--slate) transparent;
    }

    .sidebar-inner {
      background: var(--dark-walnut);
      border: 1px solid var(--iron-edge);
      border-radius: 4px;
      padding: 1rem;
    }

    .sb-section {
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--iron-edge);
    }

    .sb-section:last-of-type {
      border-bottom: none;
      margin-bottom: 0.5rem;
    }

    .sb-heading {
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--pale-gold);
      margin-bottom: 0.5rem;
      cursor: default;
    }

    .sb-collapsible > summary {
      cursor: pointer;
      list-style: none;
    }

    .sb-collapsible > summary::before {
      content: "\25B6";
      font-size: 0.6rem;
      margin-right: 0.4rem;
      color: var(--dim-stone);
      display: inline-block;
      transition: transform 0.15s;
    }

    .sb-collapsible[open] > summary::before {
      transform: rotate(90deg);
    }

    .sb-options {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .sb-scroll {
      max-height: 240px;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--slate) transparent;
    }

    .sb-check,
    .sb-radio {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.85rem;
      color: var(--dusty-silver);
      padding: 0.2rem 0.3rem;
      border-radius: 3px;
      cursor: pointer;
      transition: background 0.1s;
    }

    .sb-check:hover,
    .sb-radio:hover {
      background: var(--charred-oak);
      color: var(--ivory);
    }

    /* Tooltip: styles applied inline via JS (scoped CSS can't reach dynamic body children) */

    .sb-check input,
    .sb-radio input {
      accent-color: var(--royal-gold);
      cursor: pointer;
    }

    .sb-count {
      margin-left: auto;
      font-size: 0.7rem;
      color: var(--dim-stone);
      font-variant-numeric: tabular-nums;
    }

    /* Tree structure */
    .sb-tree {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      max-height: 320px;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--slate) transparent;
    }

    .sb-subgroup {
      border-left: 2px solid var(--iron-edge);
      padding-left: 0.5rem;
      margin-left: 0.2rem;
    }

    .sb-subgroup[open] {
      border-left-color: var(--royal-gold);
    }

    .sb-subheading {
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--dusty-silver);
      cursor: pointer;
      padding: 0.2rem 0.2rem;
      display: flex;
      align-items: center;
      gap: 0.3rem;
      list-style: none;
    }

    .sb-subheading:hover {
      color: var(--ivory);
    }

    .sb-subheading::before {
      content: "\25B8";
      font-size: 0.6rem;
      color: var(--dim-stone);
      transition: transform 0.1s;
    }

    .sb-subgroup[open] > .sb-subheading::before {
      transform: rotate(90deg);
    }

    .sb-subgroup .sb-options {
      padding-left: 0.4rem;
    }

    .sb-label-text {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .sb-reset {
      width: 100%;
      padding: 0.4rem;
      font-family: var(--font-body);
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--dusty-silver);
      background: none;
      border: 1px solid var(--iron-edge);
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.15s;
    }

    .sb-reset:hover {
      color: var(--ivory);
      border-color: var(--royal-gold);
    }

    /* Search */
    .search-wrap {
      position: relative;
    }

    .search-icon {
      position: absolute;
      left: 0.6rem;
      top: 50%;
      transform: translateY(-50%);
      width: 14px;
      height: 14px;
      color: var(--dim-stone);
      pointer-events: none;
    }

    #search {
      width: 100%;
      padding: 0.45rem 0.5rem 0.45rem 2rem;
      font-size: 0.85rem;
      font-family: var(--font-body);
      background: var(--charred-oak);
      border: 1px solid var(--iron-edge);
      border-radius: 3px;
      color: var(--ivory);
    }

    #search::placeholder { color: var(--dim-stone); }

    #search:focus {
      outline: none;
      border-color: var(--royal-gold);
      box-shadow: 0 0 0 2px rgba(201, 168, 76, 0.15);
    }

    /* ═══ RESULTS ═══ */
    .results-toolbar {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.25rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--gold-thread);
      flex-wrap: wrap;
    }

    .results-toolbar h1 {
      font-family: var(--font-display);
      font-size: 1.75rem;
      letter-spacing: 0.03em;
      color: var(--royal-gold);
      white-space: nowrap;
    }

    .toolbar-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      flex: 1;
    }

    .result-count {
      font-size: 0.9rem;
      color: var(--dusty-silver);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .active-chips {
      display: flex;
      gap: 0.3rem;
      flex-wrap: wrap;
    }

    .chip {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 500;
      padding: 0.1rem 0.45rem;
      border-radius: 2px;
      background: rgba(201, 168, 76, 0.12);
      color: var(--pale-gold);
      border: 1px solid rgba(201, 168, 76, 0.25);
    }

    /* ═══ TABLE ═══ */
    .table-wrap {
      overflow-x: auto;
      background: var(--dark-walnut);
      border: 1px solid var(--iron-edge);
      border-radius: 4px;
    }

    #buildings-table {
      width: 100%;
      border-collapse: collapse;
    }

    #buildings-table thead {
      background: var(--charred-oak);
      position: sticky;
      top: 0;
      z-index: 2;
    }

    #buildings-table th {
      padding: 0.55rem 0.6rem;
      text-align: left;
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 0.78rem;
      color: var(--dusty-silver);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--iron-edge);
      white-space: nowrap;
    }

    #buildings-table td {
      padding: 0.45rem 0.6rem;
      font-size: 0.9rem;
      border-bottom: 1px solid rgba(46, 52, 71, 0.5);
      vertical-align: middle;
    }

    .col-icon { width: 32px; }
    .col-en { color: var(--dusty-silver); }
    .col-avail { width: 48px; text-align: center; }
    .col-conds { min-width: 100px; }

    /* cell-* and row hover → moved to <style is:global> */

    /* No results */
    .no-results {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--dusty-silver);
    }

    .undo-btn {
      margin-top: 1rem;
      padding: 0.4rem 1rem;
      font-family: var(--font-body);
      font-size: 0.85rem;
      color: var(--pale-gold);
      background: none;
      border: 1px solid var(--royal-gold);
      border-radius: 3px;
      cursor: pointer;
    }

    .undo-btn:hover {
      background: rgba(201, 168, 76, 0.1);
    }
  </style>
</Base>
