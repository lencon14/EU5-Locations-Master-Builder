---
import Base from "../../../../layouts/Base.astro";
import { LANG_CODES, type Lang } from "../../../../i18n/config";
import { t, tf } from "../../../../i18n/ui";
import { loadCore, loadBuildingLoc, gameTerm } from "../../../../i18n/data";
import type { BuildingItem } from "../../../../i18n/types";

export function getStaticPaths() {
  return LANG_CODES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const buildings = loadCore<BuildingItem>("buildings");
const bLoc = loadBuildingLoc(lang);
const bLocEn = lang !== "en" ? loadBuildingLoc("en") : bLoc;

const categoryOrder = [
  "government_category", "military_category", "defense_category",
  "naval_category", "trade_category", "basic_industry_category",
  "consumer_goods_category", "weapons_industry_category",
  "rgo_building_category", "infrastructure_category",
  "religious_category", "cultural_category",
  "estate_category", "colonial_category", "village_category",
];

// Pre-compute category counts
const catCounts: Record<string, number> = {};
for (const b of buildings) {
  if (b.category) catCounts[b.category] = (catCounts[b.category] || 0) + 1;
}

// Collect all unique facets with counts
type FacetOption = { facet: string; count: number };
const facetCounts: Record<string, number> = {};
for (const b of buildings) {
  for (const f of b.facets ?? []) {
    facetCounts[f] = (facetCounts[f] || 0) + 1;
  }
}

// Group facets by prefix
const facetsByPrefix: Record<string, FacetOption[]> = {};
for (const [f, count] of Object.entries(facetCounts)) {
  const prefix = f.split(":")[0];
  if (!facetsByPrefix[prefix]) facetsByPrefix[prefix] = [];
  facetsByPrefix[prefix].push({ facet: f, count });
}
for (const prefix of Object.keys(facetsByPrefix)) {
  facetsByPrefix[prefix].sort((a, b) => b.count - a.count);
}

// Availability counts (derived from facets)
const eventCount = facetCounts["avail:event_only"] ?? 0;
const normalCount = buildings.length - eventCount;

// Facet label resolver: facet token → localized label
function facetLabel(facet: string): string {
  const suffix = facet.split(":")[1] ?? facet;
  return t(lang, `buildings.facet.${suffix}` as any) ?? suffix;
}

// UI labels
const availNormalLabel = t(lang, "buildings.avail.normal");
const availEventLabel = t(lang, "buildings.avail.event");
const searchPlaceholder = t(lang, "common.search");
const clearLabel = t(lang, "buildings.filter.clear");
const noResultsText = t(lang, "buildings.filter.no_results");
const undoLabel = t(lang, "buildings.filter.undo");
const itemsUnit = t(lang, "buildings.count_unit");
const excludeLabel = t(lang, "buildings.exclude");
const locCondLabel = gameTerm(lang, "cond_category.location");
const ctyCondLabel = gameTerm(lang, "cond_category.country");
const allowCondLabel = gameTerm(lang, "cond_category.allow");
const flagLabel = gameTerm(lang, "cond_category.flag");
---

<Base lang={lang} title={t(lang, "buildings.title")} canonicalPath="/buildings/" wide>
  <div class="page-layout">
    <!-- ═══ LEFT SIDEBAR ═══ -->
    <aside class="sidebar">
      <div class="sidebar-inner">
        <div class="sb-section">
          <div class="search-wrap">
            <svg class="search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="8.5" cy="8.5" r="5.5" /><path d="M12.5 12.5L17 17" stroke-linecap="round" />
            </svg>
            <input type="text" id="search" placeholder={searchPlaceholder} />
          </div>
        </div>

        <div class="sb-section">
          <h3 class="sb-heading">{t(lang, "buildings.filter.availability")}</h3>
          <div class="sb-options">
            <label class="sb-check"><input type="checkbox" data-group="avail" value="normal" checked /> {availNormalLabel} <span class="sb-count">{normalCount}</span></label>
            <label class="sb-check"><input type="checkbox" data-group="avail" value="event" checked /> {availEventLabel} <span class="sb-count">{eventCount}</span></label>
          </div>
        </div>

        <div class="sb-section">
          <h3 class="sb-heading">{t(lang, "common.category")}</h3>
          <div class="sb-options sb-scroll">
            {categoryOrder.map((cat) => (
              <label class="sb-check">
                <input type="checkbox" data-group="category" value={cat} checked />
                {gameTerm(lang, `building_category.${cat}`)} <span class="sb-count">{catCounts[cat] || 0}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="sb-section">
          <h3 class="sb-heading">{t(lang, "buildings.detail.settlement")}</h3>
          <div class="sb-options">
            {["rural_settlement", "town", "city"].map((s) => (
              <label class="sb-check">
                <input type="checkbox" data-group="settlement" value={s} checked />
                {gameTerm(lang, `settlement.${s}`)}
              </label>
            ))}
          </div>
        </div>

        <details class="sb-section sb-collapsible" open>
          <summary class="sb-heading">{locCondLabel}</summary>
          <div class="sb-options">
            {(facetsByPrefix["loc"] ?? []).map((opt) => (
              <label class="sb-check">
                <input type="checkbox" data-group="facet" value={opt.facet} checked />
                <span class="sb-label-text">{facetLabel(opt.facet)}</span>
                <span class="sb-count">{opt.count}</span>
              </label>
            ))}
          </div>
        </details>

        <details class="sb-section sb-collapsible">
          <summary class="sb-heading">{ctyCondLabel}</summary>
          <div class="sb-options">
            {(facetsByPrefix["cty"] ?? []).map((opt) => (
              <label class="sb-check">
                <input type="checkbox" data-group="facet" value={opt.facet} checked />
                <span class="sb-label-text">{facetLabel(opt.facet)}</span>
                <span class="sb-count">{opt.count}</span>
              </label>
            ))}
          </div>
        </details>

        <div class="sb-section">
          <h3 class="sb-heading">{flagLabel}</h3>
          <div class="sb-options">
            {(facetsByPrefix["trait"] ?? []).map((opt) => (
              <label class="sb-check">
                <input type="checkbox" data-group="facet" value={opt.facet} checked />
                <span class="sb-label-text">{facetLabel(opt.facet)}</span>
                <span class="sb-count">{opt.count}</span>
              </label>
            ))}
          </div>
        </div>

        <button class="sb-reset" id="reset-all">{clearLabel}</button>
      </div>
    </aside>

    <!-- ═══ RIGHT RESULTS ═══ -->
    <div class="results">
      <div class="results-toolbar">
        <h1>{t(lang, "buildings.title")}</h1>
        <div class="toolbar-right">
          <span class="result-count" id="result-count"></span>
          <div class="active-chips" id="active-chips"></div>
        </div>
      </div>

      <div class="table-wrap" id="table-wrap">
        <table id="buildings-table">
          <thead>
            <tr>
              <th class="col-icon"></th>
              <th class="col-name">{t(lang, "buildings.col.name")}</th>
              {lang !== "en" && <th class="col-en">EN</th>}
              <th class="col-cat">{t(lang, "common.category")}</th>
              <th class="col-pop">{t(lang, "buildings.detail.pop_type")}</th>
              <th class="col-settle">{t(lang, "buildings.detail.settlement")}</th>
              <th class="col-avail">{t(lang, "buildings.col.build")}</th>
              <th class="col-conds">{t(lang, "buildings.detail.conditions")}</th>
            </tr>
          </thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>

      <div class="no-results" id="no-results" style="display:none">
        <p>{noResultsText}</p>
        <button class="undo-btn" id="undo-filter">{undoLabel}</button>
      </div>
    </div>
  </div>

  <!-- Building data as JS -->
  <script is:inline define:vars={{
    currentLang: lang,
    showEnCol: lang !== "en",
    availNormalLabel,
    availEventLabel,
    itemsUnit,
    excludeLabel,
    buildingsJson: JSON.stringify(buildings.map((b) => ({
      id: b.id,
      name: bLoc[b.id]?.name ?? b.id,
      nameEn: bLocEn[b.id]?.name ?? b.id,
      cat: b.category ?? "",
      pop: b.pop_type ?? "",
      settle: b.settlements ?? [],
      facets: b.facets ?? [],
      isEvent: (b.facets ?? []).includes("avail:event_only"),
      icon: b.icon,
      condLines: (bLoc[b.id]?.condition_lines ?? []).filter((_, i) => {
        const req = b.requirements?.[i];
        return req && req.type !== "flag" && req.type !== "event_only";
      }),
      search: `${bLoc[b.id]?.name ?? ""} ${bLocEn[b.id]?.name ?? ""} ${b.id}`.toLowerCase(),
    }))),
    catLabels: JSON.stringify(Object.fromEntries(categoryOrder.map(c => [c, gameTerm(lang, `building_category.${c}`)]))),
    popLabels: JSON.stringify(Object.fromEntries(["nobles","burghers","clergy","soldiers","laborers","peasants","slaves","tribesmen"].map(p => [p, gameTerm(lang, `pop.${p}`)]))),
    settleLabels: JSON.stringify(Object.fromEntries(["rural_settlement","town","city"].map(s => [s, gameTerm(lang, `settlement.${s}`)]))),
  }}>
    const ALL_BUILDINGS = JSON.parse(buildingsJson);
    const CAT_LABELS = JSON.parse(catLabels);
    const POP_LABELS = JSON.parse(popLabels);
    const SETTLE_LABELS = JSON.parse(settleLabels);

    const tbody = document.getElementById("tbody");
    const countEl = document.getElementById("result-count");
    const chipsEl = document.getElementById("active-chips");
    const noResults = document.getElementById("no-results");
    const tableWrap = document.getElementById("table-wrap");
    const searchInput = document.getElementById("search");
    const resetBtn = document.getElementById("reset-all");
    const undoBtn = document.getElementById("undo-filter");

    const cbCache = {};
    for (const g of ["avail", "category", "settlement", "facet"]) {
      cbCache[g] = Array.from(document.querySelectorAll(`input[data-group="${g}"]`));
    }

    function getUncheckedSet(group) {
      const s = new Set();
      for (const el of cbCache[group]) { if (!el.checked) s.add(el.value); }
      return s;
    }

    let lastAction = null;
    let debounceTimer = 0;

    function scheduleFilter() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(render, 16);
    }

    function render() {
      const q = searchInput.value.toLowerCase();
      const uAvail = getUncheckedSet("avail");
      const uCat = getUncheckedSet("category");
      const uSettle = getUncheckedSet("settlement");
      const uFacets = getUncheckedSet("facet");

      const filtered = [];
      for (const b of ALL_BUILDINGS) {
        if (q && !b.search.includes(q)) continue;
        // Availability filter
        if (uAvail.has("normal") && !b.isEvent) continue;
        if (uAvail.has("event") && b.isEvent) continue;
        // Category filter
        if (uCat.has(b.cat)) continue;
        // Settlement filter
        if (uSettle.size > 0 && !b.settle.some(s => !uSettle.has(s))) continue;
        // Facet filter: exclude if building has any unchecked facet
        if (uFacets.size > 0) {
          let excl = false;
          for (const f of b.facets) {
            if (uFacets.has(f)) { excl = true; break; }
          }
          if (excl) continue;
        }
        filtered.push(b);
      }

      const html = [];
      for (const b of filtered) {
        const settleHtml = b.settle.map(s =>
          `<span class="s-badge">${SETTLE_LABELS[s] || s}</span>`
        ).join("");
        const availHtml = b.isEvent
          ? `<span class="avail-badge avail-event" title="${availEventLabel}">EV</span>`
          : `<span class="avail-badge avail-ok" title="${availNormalLabel}">OK</span>`;
        let condsHtml = "";
        if (b.condLines.length > 0) {
          const shown = b.condLines.slice(0, 2);
          condsHtml = shown.map(t => `<span class="cond-chip cond-misc">${t}</span>`).join("");
          if (b.condLines.length > 2) condsHtml += `<span class="cond-more">+${b.condLines.length - 2}</span>`;
        }
        const enCol = showEnCol ? `<td class="cell-en">${b.nameEn}</td>` : "";
        html.push(`<tr><td class="cell-icon"><img src="/${b.icon}" alt="" width="24" height="24" loading="lazy"></td><td class="cell-name"><a href="/${currentLang}/eu5/buildings/${b.id}/">${b.name}</a></td>${enCol}<td class="cell-cat"><span class="cat-badge">${CAT_LABELS[b.cat] || b.cat}</span></td><td class="cell-pop"><span class="pop-tag">${POP_LABELS[b.pop] || b.pop}</span></td><td class="cell-settle">${settleHtml}</td><td class="cell-avail">${availHtml}</td><td class="cell-conds">${condsHtml}</td></tr>`);
      }
      tbody.innerHTML = html.join("");

      countEl.textContent = `${filtered.length} / ${ALL_BUILDINGS.length} ${itemsUnit}`;
      tableWrap.style.display = filtered.length > 0 ? "" : "none";
      noResults.style.display = filtered.length === 0 ? "" : "none";

      const chips = [];
      if (uAvail.size > 0) uAvail.forEach(v => chips.push((v === "normal" ? availNormalLabel : availEventLabel) + " " + excludeLabel));
      if (uCat.size > 0 && uCat.size <= 3) uCat.forEach(v => chips.push((CAT_LABELS[v]||v) + " " + excludeLabel));
      else if (uCat.size > 3) chips.push(uCat.size + " cat " + excludeLabel);
      if (uSettle.size > 0) uSettle.forEach(v => chips.push((SETTLE_LABELS[v]||v) + " " + excludeLabel));
      if (uFacets.size > 0 && uFacets.size <= 3) uFacets.forEach(v => chips.push(v + " " + excludeLabel));
      else if (uFacets.size > 3) chips.push(uFacets.size + " facets " + excludeLabel);
      if (q) chips.push(`"${q}"`);
      chipsEl.innerHTML = chips.map(c => `<span class="chip">${c}</span>`).join("");
    }

    searchInput.addEventListener("input", scheduleFilter);
    for (const g in cbCache) {
      for (const el of cbCache[g]) {
        el.addEventListener("change", () => {
          lastAction = () => { el.checked = !el.checked; render(); };
          render();
        });
      }
    }
    resetBtn.addEventListener("click", () => {
      searchInput.value = "";
      for (const g in cbCache) for (const el of cbCache[g]) el.checked = true;
      lastAction = null;
      render();
    });
    undoBtn.addEventListener("click", () => { if (lastAction) { lastAction(); lastAction = null; } });

    render();
  </script>

  <!-- JS動的生成要素のスタイル（Astroスコープ外） -->
  <style is:global>
    /* Category badge */
    .cat-badge {
      display: inline-block;
      background: rgba(201, 168, 76, 0.12);
      color: #e8d5a3;
      border-radius: 2px;
      padding: 0.1rem 0.4rem;
      font-size: var(--type-tiny);
      font-weight: 500;
    }

    /* Pop tags */
    .pop-tag {
      display: inline-block;
      background: rgba(201, 168, 76, 0.15);
      color: #e8d5a3;
      border-radius: 2px;
      padding: 0.1rem 0.4rem;
      font-size: var(--type-tiny);
      font-weight: 500;
    }

    /* Settlement badges */
    .s-badge {
      display: inline-block;
      background: #2a3042;
      color: #9a9bab;
      border-radius: 2px;
      padding: 0.1rem 0.35rem;
      font-size: var(--type-tiny);
      font-weight: 500;
      margin-right: 0.15rem;
    }

    /* Availability badge */
    .avail-badge {
      display: inline-block;
      border-radius: 2px;
      padding: 0.1rem 0.35rem;
      font-size: var(--type-micro);
      font-weight: 700;
      letter-spacing: 0.03em;
    }

    .avail-ok { background: rgba(76,154,90,0.18); color: #8cc89a; }
    .avail-event { background: rgba(196,79,79,0.18); color: #e09090; }

    /* Condition chips */
    .cond-chip {
      display: inline-block;
      font-size: var(--type-micro);
      font-weight: 500;
      padding: 0.1rem 0.35rem;
      border-radius: 2px;
      margin: 0.08rem 0.1rem;
      white-space: nowrap;
      background: rgba(74,142,201,0.1);
      color: #8cbde8;
      border: 1px solid rgba(74,142,201,0.15);
    }

    .cond-more {
      display: inline-block;
      font-size: var(--type-nano);
      color: #5c5f72;
      margin-left: 0.2rem;
      vertical-align: middle;
    }

    /* Cell styles (JS動的生成) */
    .cell-icon {
      text-align: center;
      padding: 0.3rem 0.25rem;
    }

    .cell-icon img {
      image-rendering: pixelated;
      vertical-align: middle;
    }

    .cell-name a {
      color: #4a8ec9;
      font-weight: 500;
      text-decoration: none;
    }

    .cell-name a:hover {
      color: #e8d5a3;
      text-decoration: underline;
    }

    .cell-en {
      color: #5c5f72;
      font-size: var(--type-tag);
    }

    .cell-avail { text-align: center; }

    /* Row hover */
    #buildings-table tbody tr {
      transition: background 0.1s;
    }

    #buildings-table tbody tr:hover {
      background: #2a3042;
    }
  </style>

  <style>
    /* ═══ PAGE LAYOUT ═══ */
    .page-layout {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 1.5rem;
      align-items: start;
    }

    /* ═══ SIDEBAR ═══ */
    .sidebar {
      position: sticky;
      top: 72px;
      max-height: calc(100vh - 88px);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--slate) transparent;
    }

    .sidebar-inner {
      background: var(--dark-walnut);
      border: 1px solid var(--iron-edge);
      border-radius: 4px;
      padding: 1rem;
    }

    .sb-section {
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--iron-edge);
    }

    .sb-section:last-of-type {
      border-bottom: none;
      margin-bottom: 0.5rem;
    }

    .sb-heading {
      font-family: var(--font-body);
      font-size: var(--type-sm);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--pale-gold);
      margin-bottom: 0.5rem;
      cursor: default;
    }

    .sb-collapsible > summary {
      cursor: pointer;
      list-style: none;
    }

    .sb-collapsible > summary::before {
      content: "\25B6";
      font-size: var(--type-nano);
      margin-right: 0.4rem;
      color: var(--dim-stone);
      display: inline-block;
      transition: transform 0.15s;
    }

    .sb-collapsible[open] > summary::before {
      transform: rotate(90deg);
    }

    .sb-options {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .sb-scroll {
      max-height: 240px;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--slate) transparent;
    }

    .sb-check,
    .sb-radio {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: var(--type-tag);
      color: var(--dusty-silver);
      padding: 0.2rem 0.3rem;
      border-radius: 3px;
      cursor: pointer;
      transition: background 0.1s;
    }

    .sb-check:hover,
    .sb-radio:hover {
      background: var(--charred-oak);
      color: var(--ivory);
    }

    /* Tooltip: styles applied inline via JS (scoped CSS can't reach dynamic body children) */

    .sb-check input,
    .sb-radio input {
      accent-color: var(--royal-gold);
      cursor: pointer;
    }

    .sb-count {
      margin-left: auto;
      font-size: var(--type-tiny);
      color: var(--dim-stone);
      font-variant-numeric: tabular-nums;
    }

    /* Tree structure */
    .sb-tree {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      max-height: 320px;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--slate) transparent;
    }

    .sb-subgroup {
      border-left: 2px solid var(--iron-edge);
      padding-left: 0.5rem;
      margin-left: 0.2rem;
    }

    .sb-subgroup[open] {
      border-left-color: var(--royal-gold);
    }

    .sb-subheading {
      font-size: var(--type-tag);
      font-weight: 500;
      color: var(--dusty-silver);
      cursor: pointer;
      padding: 0.2rem 0.2rem;
      display: flex;
      align-items: center;
      gap: 0.3rem;
      list-style: none;
    }

    .sb-subheading:hover {
      color: var(--ivory);
    }

    .sb-subheading::before {
      content: "\25B8";
      font-size: var(--type-nano);
      color: var(--dim-stone);
      transition: transform 0.1s;
    }

    .sb-subgroup[open] > .sb-subheading::before {
      transform: rotate(90deg);
    }

    .sb-subgroup .sb-options {
      padding-left: 0.4rem;
    }

    .sb-label-text {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .sb-reset {
      width: 100%;
      padding: 0.4rem;
      font-family: var(--font-body);
      font-size: var(--type-tag);
      font-weight: 500;
      color: var(--dusty-silver);
      background: none;
      border: 1px solid var(--iron-edge);
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.15s;
    }

    .sb-reset:hover {
      color: var(--ivory);
      border-color: var(--royal-gold);
    }

    /* Search */
    .search-wrap {
      position: relative;
    }

    .search-icon {
      position: absolute;
      left: 0.6rem;
      top: 50%;
      transform: translateY(-50%);
      width: 14px;
      height: 14px;
      color: var(--dim-stone);
      pointer-events: none;
    }

    #search {
      width: 100%;
      padding: 0.45rem 0.5rem 0.45rem 2rem;
      font-size: var(--type-tag);
      font-family: var(--font-body);
      background: var(--charred-oak);
      border: 1px solid var(--iron-edge);
      border-radius: 3px;
      color: var(--ivory);
    }

    #search::placeholder { color: var(--dim-stone); }

    #search:focus {
      outline: none;
      border-color: var(--royal-gold);
      box-shadow: 0 0 0 2px rgba(201, 168, 76, 0.15);
    }

    /* ═══ RESULTS ═══ */
    .results-toolbar {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.25rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--gold-thread);
      flex-wrap: wrap;
    }

    .results-toolbar h1 {
      font-family: var(--font-display);
      font-size: var(--type-h1-compact);
      letter-spacing: 0.03em;
      color: var(--royal-gold);
      white-space: nowrap;
    }

    .toolbar-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      flex: 1;
    }

    .result-count {
      font-size: var(--type-body);
      color: var(--dusty-silver);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .active-chips {
      display: flex;
      gap: 0.3rem;
      flex-wrap: wrap;
    }

    .chip {
      display: inline-block;
      font-size: var(--type-tiny);
      font-weight: 500;
      padding: 0.1rem 0.45rem;
      border-radius: 2px;
      background: rgba(201, 168, 76, 0.12);
      color: var(--pale-gold);
      border: 1px solid rgba(201, 168, 76, 0.25);
    }

    /* ═══ TABLE ═══ */
    .table-wrap {
      overflow-x: auto;
      background: var(--dark-walnut);
      border: 1px solid var(--iron-edge);
      border-radius: 4px;
    }

    #buildings-table {
      width: 100%;
      border-collapse: collapse;
    }

    #buildings-table thead {
      background: var(--charred-oak);
      position: sticky;
      top: 0;
      z-index: 2;
    }

    #buildings-table th {
      padding: 0.55rem 0.6rem;
      text-align: left;
      font-family: var(--font-body);
      font-weight: 500;
      font-size: var(--type-tag);
      color: var(--dusty-silver);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--iron-edge);
      white-space: nowrap;
    }

    #buildings-table td {
      padding: 0.45rem 0.6rem;
      font-size: var(--type-body);
      border-bottom: 1px solid rgba(46, 52, 71, 0.5);
      vertical-align: middle;
    }

    .col-icon { width: 32px; }
    .col-en { color: var(--dusty-silver); }
    .col-avail { width: 48px; text-align: center; }
    .col-conds { min-width: 100px; }

    /* cell-* and row hover → moved to <style is:global> */

    /* No results */
    .no-results {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--dusty-silver);
    }

    .undo-btn {
      margin-top: 1rem;
      padding: 0.4rem 1rem;
      font-family: var(--font-body);
      font-size: var(--type-tag);
      color: var(--pale-gold);
      background: none;
      border: 1px solid var(--royal-gold);
      border-radius: 3px;
      cursor: pointer;
    }

    .undo-btn:hover {
      background: rgba(201, 168, 76, 0.1);
    }
  </style>
</Base>
