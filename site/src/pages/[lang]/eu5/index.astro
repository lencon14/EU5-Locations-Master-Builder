---
import Base from "../../../layouts/Base.astro";
import { LANG_CODES, type Lang, localePath } from "../../../i18n/config";
import { loadCore } from "../../../i18n/data";
import { t } from "../../../i18n/ui";

export function getStaticPaths() {
  return LANG_CODES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const goodsCount = loadCore("goods").length;
const buildingsCount = 439; // legacy JSON count, until buildings core/loc ready
const religionsCount = loadCore("religions").length;
const holySitesCount = loadCore("holy_sites").length;
const aspectsCount = loadCore("aspects").length;
const governmentsCount = loadCore("governments").length;
const countriesCount = loadCore("countries").length;
---

<Base lang={lang} title="Europa Universalis V (EU5) — Paradoxpedia" fullTitle canonicalPath="/">
  <div class="hero">
    <h1>{t(lang, "home.hero_title")}</h1>
    <p class="lead">{t(lang, "home.hero_lead")}</p>
  </div>

  <section class="card-grid">
    <a href={localePath(lang, "/goods/")} class="card">
      <span class="card-label">{t(lang, "common.database")}</span>
      <h2>{t(lang, "nav.goods")}</h2>
      <p class="stat">{goodsCount}</p>
      <p class="card-desc">{t(lang, "home.card.goods_desc")}</p>
    </a>

    <a href={localePath(lang, "/buildings/")} class="card">
      <span class="card-label">{t(lang, "common.database")}</span>
      <h2>{t(lang, "nav.buildings")}</h2>
      <p class="stat">{buildingsCount}</p>
      <p class="card-desc">{t(lang, "home.card.buildings_desc")}</p>
    </a>

    <div class="card card--with-subs">
      <a href={localePath(lang, "/religions/")} class="card-main">
        <span class="card-label">{t(lang, "common.database")}</span>
        <h2>{t(lang, "nav.religions")}</h2>
        <p class="stat">{religionsCount}</p>
        <p class="card-desc">{t(lang, "home.card.religions_desc")}</p>
      </a>
      <div class="card-subs">
        <a href={localePath(lang, "/holy-sites/")} class="card-sub">
          <span class="card-sub-name">{t(lang, "nav.holy_sites")}</span>
          <span class="card-sub-count">{holySitesCount}</span>
        </a>
        <a href={localePath(lang, "/aspects/")} class="card-sub">
          <span class="card-sub-name">{t(lang, "nav.aspects")}</span>
          <span class="card-sub-count">{aspectsCount}</span>
        </a>
      </div>
    </div>

    <a href={localePath(lang, "/countries/")} class="card">
      <span class="card-label">{t(lang, "common.database")}</span>
      <h2>{t(lang, "home.card.countries")}</h2>
      <p class="stat">{countriesCount}</p>
      <p class="card-desc">{t(lang, "home.card.countries_desc")}</p>
    </a>

    <a href={localePath(lang, "/governments/")} class="card">
      <span class="card-label">{t(lang, "common.database")}</span>
      <h2>{t(lang, "home.card.governments")}</h2>
      <p class="stat">{governmentsCount}</p>
      <p class="card-desc">{t(lang, "home.card.governments_desc")}</p>
    </a>
  </section>

  <style>
    .hero {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--gold-thread);
    }

    .hero h1 {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--royal-gold);
      margin-bottom: 0.5rem;
    }

    .lead {
      color: var(--dusty-silver);
      font-size: 1rem;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1rem;
    }

    .card {
      display: block;
      background: var(--dark-walnut);
      border: 1px solid var(--iron-edge);
      border-radius: 4px;
      padding: 1.25rem;
      transition: border-color 0.2s;
    }

    a.card:hover,
    .card--with-subs:hover {
      border-color: var(--royal-gold);
      text-decoration: none;
    }

    .card-main {
      display: block;
      color: inherit;
    }

    .card-main:hover {
      text-decoration: none;
    }

    .card--disabled {
      opacity: 0.45;
      cursor: default;
    }

    .card-label {
      display: inline-block;
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--dusty-silver);
      margin-bottom: 0.5rem;
    }

    .card h2 {
      font-size: 1.15rem;
      margin-bottom: 0.25rem;
    }

    .stat {
      font-size: 2rem;
      font-weight: 700;
      color: var(--royal-gold);
      line-height: 1.2;
      margin-bottom: 0.5rem;
    }

    .card-desc {
      color: var(--dusty-silver);
      font-size: 0.8rem;
    }

    .card-subs {
      display: flex;
      gap: 0.5rem;
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--iron-edge);
    }

    .card-sub {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.25rem 0.6rem;
      background: var(--charred-oak);
      border: 1px solid var(--iron-edge);
      border-radius: 3px;
      color: var(--dusty-silver);
      font-size: 0.8rem;
      font-weight: 500;
      transition: border-color 0.15s, color 0.15s;
    }

    .card-sub:hover {
      border-color: var(--royal-gold);
      color: var(--pale-gold);
      text-decoration: none;
    }

    .card-sub-count {
      color: var(--royal-gold);
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }
  </style>
</Base>
