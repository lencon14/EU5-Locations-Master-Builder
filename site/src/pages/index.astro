---
/**
 * Root page — redirects to /{detected-lang}/eu5/
 * Priority: cookie → Accept-Language → en fallback
 * Uses 302 (not 301) per SEO guidelines
 */
import { LANG_CODES, DEFAULT_LANG } from "../i18n/config";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Paradoxpedia — Europa Universalis V Database</title>
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ langCodes: LANG_CODES, defaultLang: DEFAULT_LANG }}>
      (function () {
        // Check cookie first
        const cookieMatch = document.cookie.match(/(?:^|;\s*)lang=([^;]+)/);
        if (cookieMatch && langCodes.includes(cookieMatch[1])) {
          window.location.replace("/" + cookieMatch[1] + "/eu5/");
          return;
        }

        // Parse Accept-Language from navigator.languages
        const browserLangs = navigator.languages || [navigator.language || "en"];
        for (const raw of browserLangs) {
          const lower = raw.toLowerCase();
          // Exact match
          if (langCodes.includes(lower)) {
            window.location.replace("/" + lower + "/eu5/");
            return;
          }
          // pt-BR → pt-br
          const normalized = lower.replace("_", "-");
          if (langCodes.includes(normalized)) {
            window.location.replace("/" + normalized + "/eu5/");
            return;
          }
          // zh-CN/zh-SG → zh-hans
          if (lower.startsWith("zh")) {
            window.location.replace("/zh-hans/eu5/");
            return;
          }
          // pt → pt-br
          if (lower === "pt") {
            window.location.replace("/pt-br/eu5/");
            return;
          }
          // Primary subtag match (e.g., "en-US" → "en")
          const primary = lower.split("-")[0];
          if (langCodes.includes(primary)) {
            window.location.replace("/" + primary + "/eu5/");
            return;
          }
        }

        // Fallback
        window.location.replace("/" + defaultLang + "/eu5/");
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=/${DEFAULT_LANG}/eu5/`} />
    </noscript>
  </head>
  <body></body>
</html>
