---
import Base from "../../layouts/Base.astro";
import goods from "../../data/goods.json";

export function getStaticPaths() {
  return goods.map((g) => ({
    params: { id: g.id },
    props: { good: g },
  }));
}

const { good } = Astro.props;

const categoryLabels: Record<string, string> = {
  raw_material: "原材料",
  produced: "加工品",
  food: "食料",
  special: "特殊",
};

const methodLabels: Record<string, string> = {
  farming: "農業",
  mining: "採掘",
  gathering: "採集",
  hunting: "狩猟",
  forestry: "林業",
};

const originLabels: Record<string, string> = {
  old_world: "旧世界",
  new_world: "新世界",
};
---

<Base title={good.name_ja}>
  <nav class="breadcrumb">
    <a href="/goods/">交易品一覧</a>
    <span class="sep">&rsaquo;</span>
    <span>{good.name_ja}</span>
  </nav>

  <header class="good-header">
    <h1>{good.name_ja}</h1>
    <span class="en-name">{good.name_en}</span>
    <code class="id-badge">{good.id}</code>
  </header>

  <div class="content-grid">
    <section class="props-card">
      <h2>基本情報</h2>
      <dl>
        <div class="prop-row">
          <dt>カテゴリ</dt>
          <dd>{categoryLabels[good.category] || good.category}</dd>
        </div>
        {
          good.method && (
            <div class="prop-row">
              <dt>採取方法</dt>
              <dd>
                <span class="tag">
                  {methodLabels[good.method] || good.method}
                </span>
              </dd>
            </div>
          )
        }
        <div class="prop-row">
          <dt>基本価格</dt>
          <dd class="num-val">{good.default_market_price}</dd>
        </div>
        {
          good.transport_cost > 0 && (
            <div class="prop-row">
              <dt>輸送コスト</dt>
              <dd class="num-val">{good.transport_cost}</dd>
            </div>
          )
        }
        {
          good.base_production > 0 && (
            <div class="prop-row">
              <dt>基本生産量</dt>
              <dd class="num-val">{good.base_production}</dd>
            </div>
          )
        }
        {
          good.origin && (
            <div class="prop-row">
              <dt>産地</dt>
              <dd>{originLabels[good.origin] || good.origin}</dd>
            </div>
          )
        }
        {
          good.development_threshold && (
            <div class="prop-row">
              <dt>開発閾値</dt>
              <dd class="num-val">{good.development_threshold}</dd>
            </div>
          )
        }
        {
          good.tags && good.tags.length > 0 && (
            <div class="prop-row">
              <dt>タグ</dt>
              <dd>
                {good.tags.map((t: string) => (
                  <span class="tag">{t}</span>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </section>

    <div class="side-panels">
      {
        good.demand_add && Object.keys(good.demand_add).length > 0 && (
          <section class="panel">
            <h3>需要加算</h3>
            <table>
              <thead>
                <tr>
                  <th>階層</th>
                  <th class="num-head">値</th>
                </tr>
              </thead>
              <tbody>
                {Object.entries(good.demand_add).map(([k, v]) => (
                  <tr>
                    <td>{k}</td>
                    <td class="num">{v as number}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )
      }

      {
        good.demand_multiply && Object.keys(good.demand_multiply).length > 0 && (
          <section class="panel">
            <h3>需要乗算</h3>
            <table>
              <thead>
                <tr>
                  <th>階層</th>
                  <th class="num-head">倍率</th>
                </tr>
              </thead>
              <tbody>
                {Object.entries(good.demand_multiply).map(([k, v]) => (
                  <tr>
                    <td>{k}</td>
                    <td class="num">&times;{v as number}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )
      }

      {
        good.wealth_impact_threshold &&
          Object.keys(good.wealth_impact_threshold).length > 0 && (
            <section class="panel">
              <h3>富裕閾値</h3>
              <table>
                <thead>
                  <tr>
                    <th>階層</th>
                    <th class="num-head">閾値</th>
                  </tr>
                </thead>
                <tbody>
                  {Object.entries(good.wealth_impact_threshold).map(
                    ([k, v]) => (
                      <tr>
                        <td>{k}</td>
                        <td class="num">{v as number}</td>
                      </tr>
                    ),
                  )}
                </tbody>
              </table>
            </section>
          )
      }
    </div>
  </div>

  {
    good.desc_ja && (
      <section class="description">
        <h2>説明</h2>
        <p>{good.desc_ja}</p>
      </section>
    )
  }

  <style>
    .breadcrumb {
      margin-bottom: 1.5rem;
      font-size: 0.875rem;
      color: var(--dusty-silver);
    }

    .breadcrumb .sep {
      margin: 0 0.4rem;
      color: var(--dim-stone);
    }

    .breadcrumb span:last-child {
      color: var(--ivory);
    }

    .good-header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--gold-thread);
    }

    .good-header h1 {
      font-size: 2rem;
      color: var(--royal-gold);
      margin-bottom: 0.25rem;
    }

    .en-name {
      color: var(--dusty-silver);
      font-size: 1rem;
      margin-right: 0.75rem;
    }

    .id-badge {
      background: var(--charred-oak);
      border: 1px solid var(--iron-edge);
      border-radius: 2px;
      padding: 0.1rem 0.5rem;
      font-size: 0.75rem;
      color: var(--dim-stone);
    }

    .content-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    @media (max-width: 639px) {
      .content-grid {
        grid-template-columns: 1fr;
      }
    }

    .props-card,
    .panel {
      background: var(--dark-walnut);
      border: 1px solid var(--iron-edge);
      border-radius: 4px;
      padding: 1.25rem;
    }

    .props-card h2,
    .panel h3 {
      font-size: 0.85rem;
      font-family: var(--font-body);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--dusty-silver);
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--iron-edge);
    }

    dl {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .prop-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.4rem 0;
      border-bottom: 1px solid var(--iron-edge);
    }

    .prop-row:last-child {
      border-bottom: none;
    }

    dt {
      font-size: 0.875rem;
      color: var(--dusty-silver);
    }

    dd {
      font-size: 0.875rem;
      font-weight: 500;
    }

    .num-val {
      font-variant-numeric: tabular-nums;
    }

    .tag {
      display: inline-block;
      background: rgba(201, 168, 76, 0.15);
      color: var(--pale-gold);
      border-radius: 2px;
      padding: 0.1rem 0.5rem;
      font-size: 0.75rem;
      font-weight: 500;
    }

    .side-panels {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .panel table {
      width: 100%;
      border-collapse: collapse;
    }

    .panel thead {
      background: var(--charred-oak);
    }

    .panel th {
      padding: 0.4rem 0.5rem;
      text-align: left;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--dusty-silver);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--iron-edge);
    }

    .num-head {
      text-align: right;
    }

    .panel td {
      padding: 0.4rem 0.5rem;
      font-size: 0.875rem;
      border-bottom: 1px solid var(--iron-edge);
    }

    .num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .panel tr:last-child td {
      border-bottom: none;
    }

    .description {
      background: var(--dark-walnut);
      border: 1px solid var(--iron-edge);
      border-radius: 4px;
      padding: 1.25rem;
    }

    .description h2 {
      font-size: 0.85rem;
      font-family: var(--font-body);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--dusty-silver);
      margin-bottom: 0.75rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--iron-edge);
    }

    .description p {
      color: var(--dusty-silver);
      font-size: 0.875rem;
      line-height: 1.8;
    }
  </style>
</Base>
