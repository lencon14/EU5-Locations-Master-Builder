---
import Base from "../../layouts/Base.astro";
import goods from "../../data/goods.json";

const categoryLabels: Record<string, string> = {
  raw_material: "原材料",
  produced: "加工品",
  food: "食料",
  special: "特殊",
};

const methodLabels: Record<string, string> = {
  farming: "農業",
  mining: "採掘",
  gathering: "採集",
  hunting: "狩猟",
  forestry: "林業",
};

const grouped = new Map<string, typeof goods>();
for (const g of goods) {
  const cat = g.category || "other";
  if (!grouped.has(cat)) grouped.set(cat, []);
  grouped.get(cat)!.push(g);
}
---

<Base title="交易品一覧">
  <h1>交易品一覧</h1>
  <p class="lead">{goods.length} 品目</p>

  <div class="filter-bar">
    <input type="text" id="search" placeholder="名前で検索..." />
  </div>

  {
    [...grouped.entries()].map(([category, items]) => (
      <section class="category-section" data-category={category}>
        <h2>
          <span class="category-name">
            {categoryLabels[category] || category}
          </span>
          <span class="category-count">{items.length}</span>
        </h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>名前</th>
                <th>EN</th>
                <th>採取方法</th>
                <th class="num-head">基本価格</th>
                <th class="num-head">輸送コスト</th>
              </tr>
            </thead>
            <tbody>
              {items.map((g) => (
                <tr
                  class="goods-row"
                  data-name={`${g.name_ja} ${g.name_en} ${g.id}`}
                >
                  <td>
                    <a href={`/goods/${g.id}/`}>{g.name_ja}</a>
                  </td>
                  <td class="muted">{g.name_en}</td>
                  <td>
                    {g.method ? (
                      <span class="tag">
                        {methodLabels[g.method] || g.method}
                      </span>
                    ) : (
                      <span class="muted">-</span>
                    )}
                  </td>
                  <td class="num">{g.default_market_price}</td>
                  <td class="num">{g.transport_cost || "-"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  <script>
    const input = document.getElementById("search") as HTMLInputElement;
    const rows = document.querySelectorAll<HTMLTableRowElement>(".goods-row");

    input.addEventListener("input", () => {
      const q = input.value.toLowerCase();
      rows.forEach((row) => {
        const name = row.dataset.name?.toLowerCase() || "";
        row.style.display = name.includes(q) ? "" : "none";
      });
      document
        .querySelectorAll<HTMLElement>(".category-section")
        .forEach((sec) => {
          const visible = sec.querySelectorAll(
            '.goods-row:not([style*="display: none"])',
          );
          sec.style.display = visible.length > 0 ? "" : "none";
        });
    });
  </script>

  <style>
    h1 {
      font-size: 2rem;
      margin-bottom: 0.25rem;
    }

    .lead {
      color: var(--dusty-silver);
      margin-bottom: 1.5rem;
    }

    .filter-bar {
      margin-bottom: 2rem;
    }

    #search {
      width: 100%;
      max-width: 400px;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      font-family: var(--font-body);
      background: var(--dark-walnut);
      border: 1px solid var(--iron-edge);
      border-radius: 4px;
      color: var(--ivory);
    }

    #search::placeholder {
      color: var(--dim-stone);
    }

    #search:focus {
      outline: none;
      border-color: var(--royal-gold);
      box-shadow: 0 0 0 2px rgba(201, 168, 76, 0.2);
    }

    .category-section {
      margin-bottom: 3rem;
    }

    .category-section h2 {
      font-size: 1.15rem;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .category-name {
      padding-bottom: 0.25rem;
      border-bottom: 2px solid var(--royal-gold);
    }

    .category-count {
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--dusty-silver);
      background: var(--slate);
      padding: 0.1rem 0.5rem;
      border-radius: 2px;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead {
      background: var(--charred-oak);
    }

    th {
      padding: 0.5rem 0.75rem;
      text-align: left;
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 0.75rem;
      color: var(--dusty-silver);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--iron-edge);
    }

    .num-head {
      text-align: right;
    }

    td {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      border-bottom: 1px solid var(--iron-edge);
    }

    .muted {
      color: var(--dusty-silver);
    }

    .num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .tag {
      display: inline-block;
      background: rgba(201, 168, 76, 0.15);
      color: var(--pale-gold);
      border-radius: 2px;
      padding: 0.1rem 0.5rem;
      font-size: 0.75rem;
      font-weight: 500;
    }

    tr:hover {
      background: var(--slate);
    }

    td a {
      color: var(--ivory);
      font-weight: 500;
    }

    td a:hover {
      color: var(--pale-gold);
    }
  </style>
</Base>
