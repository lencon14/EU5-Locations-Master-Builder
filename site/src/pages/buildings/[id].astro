const methodCategoryLabels: Record<string, string> = {
  building_maintenance: "維持",
  guild_input: "ギルド投入",
  workshop_input: "工房投入",
  mills_input: "製粉投入",
  manufactory_input: "工場投入",
};

function formatMethodName(name: string, buildingId: string): string {
  let clean = name;
  // Strip common suffixes
  const suffixes: [RegExp, string][] = [
    [/_maintenance$/, ""],
    [/_requirements$/, ""],
    [/_input$/, ""],
    [/_construction$/, ""],
  ];
  for (const [pat, rep] of suffixes) {
    clean = clean.replace(pat, rep);
  }
  // Strip building id from remaining
  clean = clean.replace(new RegExp(`_?${buildingId}_?`), "_").replace(/^_|_$/g, "");
  if (!clean) return "維持";
  // Translate each word segment using goodsLabels or known terms
  const words = clean.split("_");
  const extraLabels: Record<string, string> = {
    bavarian: "バイエルン", bricks: "レンガ", stone: "石", clay: "粘土",
    honey: "蜂蜜", large: "大型", small: "小型", medium: "中型",
    early: "初期", advanced: "上級", basic: "基礎",
    local: "地方", royal: "王立", coastal: "沿岸",
    muslim: "イスラム", christian: "キリスト教", eastern: "東方",
    light: "軽", heavy: "重", raw: "原料",
  };
  const translated = words.map((w) => goodsLabels[w] || extraLabels[w] || w);
  return translated.join("・") + "式";
}

const goodsLabels: Record<string, string> = {
  alum: "ミョウバン", beer: "ビール", beeswax: "蜜蝋", books: "書物",
  cannons: "大砲", clay: "粘土", cloth: "生地", coal: "石炭",
  copper: "銅", cotton: "綿", dyes: "染料", elephants: "象",
  fiber_crops: "繊維作物", fine_cloth: "高級生地", firearms: "火器",
  fish: "魚", fruit: "果物", fur: "毛皮", furniture: "家具",
  gems: "宝石", glass: "ガラス", goods_gold: "金", horses: "馬",
  incense: "香料", iron: "鉄", ivory: "象牙", jewelry: "宝飾品",
  lacquerware: "漆器", lead: "鉛", leather: "革", liquor: "酒",
  livestock: "家畜", lumber: "木材", maize: "トウモロコシ",
  marble: "大理石", masonry: "れんが", medicaments: "薬剤",
  mercury: "水銀", millet: "雑穀", naval_supplies: "海軍用品",
  paper: "紙", pepper: "コショウ", porcelain: "磁器",
  potato: "ジャガイモ", pottery: "陶器", rice: "米", salt: "塩",
  saltpeter: "硝石", sand: "砂", silk: "絹", silver: "銀",
  slaves_goods: "奴隷", steel: "鋼", stone: "石材", sugar: "砂糖",
  tar: "タール", tin: "スズ", tobacco: "タバコ", tools: "工具",
  weaponry: "武器", wheat: "小麦", wild_game: "狩猟動物",
  wine: "ワイン", wool: "羊毛",
};

type ModEntry = { key: string; value: number | boolean; name_ja?: string };
const modifier = building.modifier as ModEntry[] | undefined;
const rawModifier = (building as any).raw_modifier as ModEntry[] | undefined;
const productionMethods = building.production_methods as Record<string, Record<string, any>> | undefined;
const conditions = (building as any).conditions as {category: string; text: string}[] | undefined;

const categoryIcons: Record<string, string> = {
  flag: "\u{1F3F7}",
  country: "\u{1F3DB}",
  location: "\u{1F4CD}",
  allow: "\u{1F512}",
};

const categoryCondLabels: Record<string, string> = {
  flag: "属性",
  country: "国家条件",
  location: "立地条件",
  allow: "建設許可",
};

function formatModValue(v: number | boolean): string {
  if (typeof v === "boolean") return v ? "Yes" : "No";
  if (v > 0 && v < 1) return `+${(v * 100).toFixed(1)}%`;
  if (v < 0 && v > -1) return `${(v * 100).toFixed(1)}%`;
  if (v > 0) return `+${v}`;
  return String(v);
}
---

<Base title={building.name_ja}>
  <nav class="breadcrumb">
    <a href="/buildings/">建物一覧</a>
    <span class="sep">&rsaquo;</span>
    <span>{building.name_ja}</span>
  </nav>

  <header class="building-header">
    <div class="header-title">
      <img
        src={`/${building.icon}`}
        alt=""
        width="48"
        height="48"
        class="header-icon"
      />
      <h1>{building.name_ja}</h1>
    </div>
    <span class="en-name">{building.name_en}</span>
    <code class="id-badge">{building.id}</code>
  </header>

  <div class="content-grid">
    <section class="props-card">
      <h2>基本情報</h2>
      <dl>
        <div class="prop-row">
          <dt>カテゴリ</dt>
          <dd>{categoryLabels[building.category] || building.category}</dd>
        </div>
        <div class="prop-row">
          <dt>担当階層</dt>
          <dd>
            <span class="tag">
              {popTypeLabels[building.pop_type] || building.pop_type}
            </span>
          </dd>
        </div>
        <div class="prop-row">
          <dt>最大レベル</dt>
          <dd class="num-val">
            {building.max_levels}
            {(building as any).max_levels_scaling && (
              <span class="scaling-note">+ {(building as any).max_levels_scaling.join(" / ")}</span>
            )}
          </dd>
        </div>
        {
          (building as any).build_days ? (
            <div class="prop-row">
              <dt>建設時間</dt>
              <dd class="num-val">
                {(building as any).build_days >= 365
                  ? `${((building as any).build_days / 365).toFixed(1).replace('.0', '')}年`
                  : `${(building as any).build_days}日`}
                <span class="build-days-sub">({(building as any).build_days}日)</span>
              </dd>
            </div>
          ) : building.build_time ? (
            <div class="prop-row">
              <dt>建設時間</dt>
              <dd>{building.build_time}</dd>
            </div>
          ) : null
        }
        {
          building.expensive && (
            <div class="prop-row">
              <dt>高コスト</dt>
              <dd>
                <span class="tag tag--warn">Yes</span>
              </dd>
            </div>
          )
        }
        <div class="prop-row">
          <dt>入植地</dt>
          <dd class="settlements">
            {
              building.settlements.map((s: string) => (
                <span class="settlement-badge">
                  {settlementLabels[s] || s}
                </span>
              ))
            }
          </dd>
        </div>
      </dl>
    </section>

    <div class="side-panels">
      {
        conditions && conditions.length > 0 && (
          <section class="panel">
            <h3>建設条件</h3>
            <ul class="cond-list">
              {conditions.map((c) => (
                <li class={`cond-item cond-${c.category}`}>
                  <span class="cond-cat">{categoryCondLabels[c.category] || c.category}</span>
                  <span class="cond-text">{c.text}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        modifier && modifier.length > 0 && (
          <section class="panel">
            <h3>効果</h3>
            <table>
              <thead>
                <tr>
                  <th>補正</th>
                  <th class="num-head">値</th>
                </tr>
              </thead>
              <tbody>
                {modifier.map((m) => (
                  <tr>
                    <td>
                      {(m as any).desc_ja ? (
                        <span class="has-tooltip" data-tip={(m as any).desc_ja}>
                          {m.name_ja || modifierLabels[m.key] || m.key}
                          <span class="tip-icon">?</span>
                        </span>
                      ) : (
                        <span>{m.name_ja || modifierLabels[m.key] || m.key}</span>
                      )}
                    </td>
                    <td class={`num ${typeof m.value === "number" && m.value > 0 ? "positive" : ""} ${typeof m.value === "number" && m.value < 0 ? "negative" : ""}`}>
                      {formatModValue(m.value)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )
      }

      {
        rawModifier && rawModifier.length > 0 && (
          <section class="panel">
            <h3>固有効果</h3>
            <table>
              <thead>
                <tr>
                  <th>補正</th>
                  <th class="num-head">値</th>
                </tr>
              </thead>
              <tbody>
                {rawModifier.map((m) => (
                  <tr>
                    <td>{m.name_ja || modifierLabels[m.key] || m.key}</td>
                    <td class="num">{formatModValue(m.value)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )
      }

      {
        productionMethods && Object.keys(productionMethods).length > 0 && (() => {
          const methodEntries = Object.entries(productionMethods);
          const hasMultiple = methodEntries.length > 1;
          const skipKeys = ["category", "produced", "output", "debug_max_profit", "_name_ja", "_category_ja"];
          return (
            <section class="panel production-sim">
              <h3>生産方式{hasMultiple && <span class="method-count">{methodEntries.length}種</span>}</h3>
              {hasMultiple && (
                <div class="method-tabs">
                  {methodEntries.map(([methodName, method], idx) => (
                    <button
                      class={`method-tab ${idx === 0 ? "is-active" : ""}`}
                      data-method={idx}
                    >
                      {method._name_ja || formatMethodName(methodName, building.id)}
                    </button>
                  ))}
                </div>
              )}
              {methodEntries.map(([methodName, method], idx) => {
                const inputs = Object.entries(method).filter(([k]) => !skipKeys.includes(k));
                const produced = method.produced as string | undefined;
                const output = method.output as number | undefined;
                const nameJa = method._name_ja as string | undefined;
                const catJa = method._category_ja as string | undefined;
                return (
                  <div class={`method-pane ${idx === 0 ? "is-active" : ""}`} data-pane={idx}>
                    {!hasMultiple && (
                      <div class="method-header">
                        <h4>{nameJa || formatMethodName(methodName, building.id)}</h4>
                        {(catJa || method.category) && (
                          <span class="method-cat">{catJa || methodCategoryLabels[method.category as string] || method.category}</span>
                        )}
                      </div>
                    )}
                    <div class="method-flow">
                      {inputs.length > 0 && (
                        <div class="flow-box flow-input">
                          <span class="flow-label">投入</span>
                          {inputs.map(([k, v]) => (
                            <div class="flow-item">
                              <a href={`/goods/${k}/`}>{goodsLabels[k] || k}</a>
                              <span class="flow-val">{v as number}</span>
                            </div>
                          ))}
                        </div>
                      )}
                      {(inputs.length > 0 && produced) && (
                        <div class="flow-arrow">&#x2192;</div>
                      )}
                      {produced && (
                        <div class="flow-box flow-output">
                          <span class="flow-label">産出</span>
                          <div class="flow-item flow-item--produced">
                            <a href={`/goods/${produced}/`}>{goodsLabels[produced] || produced}</a>
                            {output && <span class="flow-val flow-val--out">&times;{output}</span>}
                          </div>
                        </div>
                      )}
                    </div>
                    {catJa && <span class="method-cat-badge">{catJa}</span>}
                  </div>
                );
              })}
            </section>
          );
        })()
      }
    </div>
  </div>

  {
    building.desc_ja && (
      <section class="description">
        <h2>説明</h2>
        <p>{building.desc_ja}</p>
      </section>
    )
  }

  <script>
    // Production method tab switching
    document.querySelectorAll<HTMLElement>(".production-sim").forEach((sim) => {
      const tabs = sim.querySelectorAll<HTMLButtonElement>(".method-tab");
      const panes = sim.querySelectorAll<HTMLElement>(".method-pane");
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const idx = tab.dataset.method;
          tabs.forEach((t) => t.classList.remove("is-active"));
          panes.forEach((p) => p.classList.remove("is-active"));
          tab.classList.add("is-active");
          sim.querySelector(`.method-pane[data-pane="${idx}"]`)?.classList.add("is-active");
        });
      });
    });
  </script>

  <style>
    .breadcrumb {
      margin-bottom: 1.5rem;
      font-size: 0.875rem;
      color: var(--dusty-silver);
    }

    .breadcrumb .sep {
      margin: 0 0.4rem;
      color: var(--dim-stone);
    }

    .breadcrumb span:last-child {
      color: var(--ivory);
    }

    .building-header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--gold-thread);
    }

    .header-title {
      display: flex;
      align-items: center;
      gap: 0.75rem;
