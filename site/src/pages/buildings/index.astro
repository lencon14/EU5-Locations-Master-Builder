      margin-right: 0.15rem;
      border: 1px solid transparent;
    }

    .s-city { background: rgba(201,168,76,0.1); color: var(--pale-gold); border-color: rgba(201,168,76,0.2); }
    .s-town { background: rgba(74,142,201,0.1); color: #8cbde8; border-color: rgba(74,142,201,0.15); }
    .s-rural_settlement { background: rgba(76,154,90,0.1); color: #8cc89a; border-color: rgba(76,154,90,0.15); }

    /* Condition chips */
