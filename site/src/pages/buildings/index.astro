    .pop-soldiers { background: rgba(196,79,79,0.18); color: #e09090; }
    .pop-laborers { background: rgba(76,154,90,0.18); color: #8cc89a; }
    .pop-peasants { background: rgba(140,160,80,0.18); color: #b8c88c; }
