  "judaism": {
    "name": "犹太教",
    "desc": "$judaism$是最早的亚伯拉罕宗教，遵循上帝与摩西所立的约。$judaism_ADJ$的圣经是《塔纳赫》，其中前五卷被称为《妥拉》，是所有$judaism_ADJ$信徒信仰与实践的基础。"
  },
  "samaritanism": {
    "name": "撒玛利亚派",
    "desc": "撒玛利亚派是$samaritan_culture$人的传统信仰，起源于以色列王国灭亡后的$judaism$。$samaritanism$自认为是从摩西时代以来未改变的$israelite_group$，与他们认为被$judaism$篡改的经典形成对比。"
  },
  "mandeaism": {
    "name": "曼达派",
    "desc": "$mandeaism$是一种诺斯替宗教，认为施洗约翰是最后的先知，同时也包含$greek_culture$与$iranian_group$文化的影响。尽管它承认其他亚伯拉罕宗教的一些先知，但并不认为亚伯拉罕、摩西或耶稣是$mandeaism_ADJ$的先知。$mandeaism$的神被称为“$mandeaism_god_name$”（哈依·拉比），代表宇宙的创造力量。"
  },
  "manichaeism": {
    "name": "摩尼教",
    "desc": "$manichaeism$是萨珊帝国时期由先知摩尼创立的一种$iranian_group$宗教，受到诺斯替主义、$zoroastrian$、$christian$与$buddhist$等多种宗教的影响，但认为摩尼是继琐罗亚斯德、佛陀与耶稣之后的最后一位先知。其神学是二元论的，将宇宙描述为光明与黑暗之间的灵性斗争。"
  },
  "ibadi": {
    "name": "伊巴德派",
    "desc": "$ibadi_school_desc$"
  },
  "shia": {
    "name": "什叶派",
    "desc": "$shia_ADJ$信仰的基础是穆罕默德指定阿里·本·阿比·塔利卜为其继任者，作为$muslim$的精神与政治领袖。因此，$imamate$职位应按阿里的血统传承，而非穆罕默德的同伴在塞基法会议上选择阿布·伯克尔作为$rank_empire_muslim_ruler_male$时所确立的继承体系。"
  },
  "sunni": {
    "name": "逊尼派",
    "desc": "$sunni$认为$muslim_ADJ$的领导权在穆罕默德的同伴于塞基法会议上选择阿布·伯克尔作为$rank_empire_muslim_ruler_male$时移交给他，因为先知本人并未指定任何继任者。因此，逊尼派尊崇“正统$rank_empire_muslim_ruler_male$”（穆罕默德之后的四位哈里发）作为治理的典范。"
  },
  "nahuatl": {
    "name": "纳瓦特尔宗教",
    "desc": "纳瓦特尔宗教是$nahua_group$人的信仰，其众多$nahuatl_god_name$（意为神祇）在至高神奥梅特奥特的统领下组织起来。其他神祇，如$huitzilopochtli_god$、$tlaloc_god$或$quetzalcoatl_god$，常被选为领地或民族的守护神。其关键实践之一是献祭，以向神祇表示敬意并保持他们的眷顾。"
  },
  "mesoamerican": {
    "name": "托纳利宗教",
    "desc": "$mesoamerican$$common_folk_religion_desc$"
  },
  "mayan": {
    "name": "玛雅宗教",
    "desc": "$mayan$$common_folk_religion_desc$"
  },
  "chichimecah_religion": {
    "name": "奇奇梅克宗教",
    "desc": "$chichimecah_religion$$common_folk_religion_desc$"
  },
  "yazidism": {
    "name": "雅兹迪派",
    "desc": "雅兹迪教起源于$iranian_group$传统，同时也包含$judaism$、$christian$与$muslim$的元素。它认为宇宙由上帝创造，但他任命“孔雀天使”塔乌西·梅莱克统治它。尽管它受到其他宗教的许多影响，尤其是在其神秘实践中，但其核心植根于古代$iranian_group$宗教。"
  },
  "zoroastrian": {
    "name": "祆教",
    "desc": "琐罗亚斯德教是一种古老的$iranian_group$宗教，遵循查拉图斯特拉（也称琐罗亚斯德）的教义与《阿维斯塔》经典。它基于善与恶的二元宇宙观，描述了神阿胡拉·马兹达与破坏灵安格拉·曼纽之间的永恒冲突，并预言善将最终战胜恶。"
  },
