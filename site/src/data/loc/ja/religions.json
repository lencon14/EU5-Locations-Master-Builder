  "judaism": {
    "name": "ユダヤ教",
    "desc": "最初のアブラハムの宗教である$judaism$は、神とモーセのあいだで交わされた契約に忠実に従う。$judaism_ADJ$の聖典はタナハであり、そのうち最初の5巻は「トーラー」と呼ばれ、$judaism_ADJ$のあらゆる信仰と実践の基盤となっている。"
  },
  "samaritanism": {
    "name": "サマリア教",
    "desc": "$samaritan_culture$の伝統的な信仰は、イスラエル王国の滅亡後に$judaism$から派生した。$samaritanism$は、$judaism$は聖書の歪曲したとし、それとは対照的に、自分たちの信仰はモーセの時代から変わらぬ$israelite_group$人の信仰であるとしている。"
  },
  "mandeaism": {
    "name": "マンダ教",
    "desc": "グノーシス主義の宗教。洗礼者ヨハネを最後の預言者とみなす。また、$mandeaism$は$greek_culture$や$iranian_group$の影響も受けている。ほかのアブラハムの宗教の一部の予言者を予言者とみなす一方で、アブラハム、モーゼス、イエスを$mandeaism_ADJ$の預言者と認めていない。$mandeaism$の神は$mandeaism_god_name$（「偉大なる生命」を意味する）と呼ばれ、宇宙の創造力の象徴とされている。"
  },
  "manichaeism": {
    "name": "マニ教",
    "desc": "$manichaeism$は、ササン朝ペルシアで預言者マニによって創始された$iranian_group$の宗教である。グノーシス主義、$zoroastrian$、$christian$、$buddhist$など、さまざまな宗教の影響を受ける一方、マニをゾロアスター、仏陀、イエスのあとに現れた最終的な預言者とみなす。その神学は二元論的であり、宇宙を光と闇のあいだで繰り広げられる霊的な戦いとして説明している。"
  },
  "ibadi": {
    "name": "イバード派",
    "desc": "$ibadi_school_desc$"
  },
  "shia": {
    "name": "シーア派",
    "desc": "$shia_ADJ$の信仰の基盤は、ムハンマドがアリー・イブン・アビー・ターリブを、$muslim$の精神的・政治的指導者として後継者に指名したことにある。そのため$imamate$は、ムハンマドの教友がサキファの会議でアブ・バカルを$rank_empire_muslim_ruler_male$に選んだときに確立された系譜ではなく、アリーの系譜に従う。"
  },
  "sunni": {
    "name": "スンニ派",
    "desc": "$sunni$は、予言者ムハンマドが後継者を指名しなかったため、教友たちがサキファの会議でアブ・バカルを$rank_empire_muslim_ruler_male$として選び、それによって$muslim$の指導者の地位がアブ・バカルに継承されたと主張する。そのため、$sunni$は、ムハンマドに続く最初の4人の$rank_empire_muslim_ruler_male$であるラシダンを統治者の模範として敬う。"
  },
  "nahuatl": {
    "name": "ナワ信仰",
    "desc": "$nahua_group$の宗教では、多くの$nahuatl_god_name$（神々）が至高神オメテオトルのもとに組織されている。$huitzilopochtli_god$、$tlaloc_god$、$quetzalcoatl_god$などの多くの神々は、一般的に領地や民族の守護神として崇められている。この宗教の主な慣習のひとつに人間の生贄がある。これは神々に敬意を表すためにおこなわわれるもので、神々の恩恵を保つために必要な儀式である。"
  },
  "mesoamerican": {
    "name": "トナル",
    "desc": "$mesoamerican$$common_folk_religion_desc$"
  },
  "mayan": {
    "name": "マヤ信仰",
    "desc": "$mayan$$common_folk_religion_desc$"
  },
  "chichimecah_religion": {
    "name": "チチメカ信仰",
    "desc": "$chichimecah_religion$$common_folk_religion_desc$"
  },
  "yazidism": {
    "name": "ヤズィーディー教",
    "desc": "$iranian_group$の伝統から発展した宗教。$judaism$、$christian$、$muslim$の要素も備える。宇宙は神によって創造されたが、神は孔雀天使マラク・ターウースをその支配者として任命したとする。ほかの宗教の影響が多く見られ、特に秘儀的な儀式はその傾向が強いが、核心部分は古代の$iranian_group$の宗教に根ざしている。"
  },
  "zoroastrian": {
    "name": "ゾロアスター教",
    "desc": "古代の$iranian_group$の宗教で、ゾロアスター（ザラスシュトラ）の教えと聖典『アヴェスター』に従う。善の神アフラ・マズダーと破壊の神アンラ・マンユの永遠の対立を軸とした、善と悪の二元論的な宇宙観を特徴とし、最終的には善が悪に勝利すると予言されている。"
  },
