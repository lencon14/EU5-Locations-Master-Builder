  "shrine": {
    "name": "Schrein",
    "desc": "Ein Schrein wird an einem Ort von spiritueller Bedeutung errichtet und dient als Bewahrer dieser Spiritualität sowie als Anlaufstelle für dessen organisierte Verehrung."
  },
  "mountain": {
    "name": "Berg",
    "desc": "Berge wurden schon seit jeher als Quellen des Göttlichen gesehen, und viele erachtet man als Sakralstätten oder gar Manifestationen der Götter selbst."
  },
  "temple": {
    "name": "Tempel",
    "desc": "Ein Tempel ist ein Ort der Verehrung, an denen der Klerusstand seinen religiösen Pflichten nachgeht. Tempel können unterschiedliche Formen aufweisen (je nach der örtlichen Religion), ihr Zweck ist aber stets der Gleiche."
  },
