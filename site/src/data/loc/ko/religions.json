    "desc": "원조 아브라함 계통 종교라고 부를 수 있는 $judaism$는 하느님과 모세 사이의 언약을 굳게 따르는 종교입니다. $judaism_ADJ$는 '타나크'라는 히브리 성경을 경전으로 사용하는데, 그중 첫 다섯 권인 토라(모세오경)는 모든 $judaism_ADJ$ 신앙과 실천의 기초를 이룹니다."
  },
  "samaritanism": {
    "name": "사마리아교",
    "desc": "$samaritan_culture$의 전통 종교로, 이스라엘 왕국의 멸망 후 $judaism$에서 갈라져 나왔습니다. $samaritanism$ 신도들은 $judaism$의 경전은 변질된 것이라고 여기며, 자신들이야말로 $israelite_group$ 민족의 신앙을 모세 시대부터 한 치의 변화 없이 수호해 왔다고 주장합니다."
  },
  "mandeaism": {
    "name": "만다야교",
    "desc": "세례 요한을 마지막 선지자로 여기는 영지주의 종교인 $mandeaism$에는 $greek_culture$와 $iranian_group$의 영향도 다소 남아 있습니다. 다른 아브라함 계통 종교의 선지자도 일부 인정하지만, 아브라함, 모세, 예수는 $mandeaism_ADJ$의 선지자로 여겨지지 않습니다. $mandeaism_ADJ$는 우주에 깃든 창조의 힘을 나타낸 존재인 $mandeaism_god_name$를 신으로 섬기는데, 이 이름에는 '위대한 생명'이라는 의미가 담겨 있습니다."
  },
  "manichaeism": {
    "name": "마니교",
    "desc": "$manichaeism$는 선지자 마니가 사산 제국에서 창시한 $iranian_group$ 종교입니다. 영지주의, $zoroastrian$, $christian$, $buddhist$ 등 다양한 종교의 영향을 받았으나, 마니를 조로아스터, 부처, 예수를 잇는 마지막 선지자로 여깁니다. 이원론적 신학을 주장하며, 우주를 빛과 어둠 사이의 영적 투쟁으로 설명합니다."
  },
  "ibadi": {
    "name": "이바디파",
    "desc": "$ibadi_school_desc$"
  },
  "shia": {
    "name": "시아파",
    "desc": "$shia_ADJ$ 신앙의 기저에는 선지자 무함마드가 알리 이븐 아비 탈리브를 $muslim$ 세계의 영적, 정치적 지도자가 될 후계자로 점지했다는 믿음이 깔려 있습니다. 따라서 $shia_ADJ$에 의하면 $imamate$은 아부 바크르가 사키파에서 무함마드의 동료들에 의해 $rank_empire_muslim_ruler_male$로 선출되었을 당시 정립된 계보가 아니라 알리의 계보를 따라야 합니다."
  },
  "sunni": {
    "name": "수니파",
    "desc": "$sunni$는 선지자 무함마드는 스스로 후계자를 점지한 바가 없다고 주장합니다. 이들의 입장에 따르면 아부 바크르는 사키파에서 무함마드의 동료들에 의해 $rank_empire_muslim_ruler_male$로 선출되었으니 무함마드로부터 $muslim$ 지도자의 지위를 물려받은 것이나 마찬가지라고 합니다. 따라서 $sunni$는 무함마드의 뒤를 이은 네 명의 $rank_empire_muslim_ruler_male$인 알라시둔을 통치자의 모범으로 숭상합니다."
  },
  "nahuatl": {
    "name": "나와족 의식",
    "desc": "최고신인 오메테오틀 아래에 여러 신, 다시 말해 $nahuatl_god_name$이 체계를 이루고 있는 $nahua_group$ 종교입니다. $huitzilopochtli_god$, $tlaloc_god$, $quetzalcoatl_god$ 등 많은 신을 계층이나 민족의 수호자로서 받들어 모십니다. 이 종교의 핵심 의식은 바로 인신 공양으로, 신들을 기리는 동시에 신들의 총애를 잃지 않기 위해 행해집니다."
  },
  "mesoamerican": {
    "name": "토날",
    "desc": "$mesoamerican$ $common_folk_religion_desc$"
  },
  "mayan": {
    "name": "마야 의식",
    "desc": "$mayan$ $common_folk_religion_desc$"
  },
  "chichimecah_religion": {
    "name": "치치멕",
    "desc": "$chichimecah_religion$ $common_folk_religion_desc$"
  },
  "yazidism": {
    "name": "야지디교",
    "desc": "$iranian_group$ 전통에서 유래한 종교로, $judaism$, $christian$, $muslim$의 요소도 일부 포함되어 있습니다. 유일신이 우주를 창조한 뒤 공작의 모습으로 현신한 천사인 '타우셰 멜렉'을 두어 다스리게 했다고 믿습니다. 신비주의적 요소를 포함해 다른 종교에서 많은 영향을 받았지만, 그 핵심만큼은 고대 $iranian_group$ 종교에 굳건히 뿌리내리고 있습니다."
  },
  "zoroastrian": {
    "name": "조로아스터교",
    "desc": "자라투스트라라고도 불리는 조로아스터의 가르침을 따르는 고대 $iranian_group$의 종교로, 아베스타를 경전으로 삼습니다. 선과 악이라는 이원론적 우주론을 바탕으로 하며, 창조신 아후라 마즈다와 파괴의 악신인 앙그라 마이뉴가 벌이는 영원한 싸움과 끝끝내 찾아올 악에 맞선 선의 궁극적 승리를 예언합니다."
  },
