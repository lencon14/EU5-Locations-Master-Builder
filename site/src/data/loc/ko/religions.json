  "rmaism": {
    "name": "",
    "desc": "$rmaism$은 아주 오래전부터 신도들의 입에서 입으로 전해 내려온 토착 신앙, 신화, 전통 및 관습을 말합니다."
  },
  "shamanism": {
    "name": "샤머니즘",
    "desc": "영혼계와 교류하고 영혼이나 영적인 에너지를 사용해 실제 세계에 영향을 미칠 수 있는 인물인 샤먼을 중심으로 하는 여러 의식 및 신앙을 한데 묶어 일컫는 개념입니다. 정령, 신, 의식 등 구체적인 양상은 매우 다양하지만, 영적 세계와 물질세계의 상호 작용이라는 핵심 개념만은 모든 $shamanism_ADJ$ 의식에서 공통적으로 나타납니다."
  },
  "tengri": {
    "name": "텡그리 신앙",
    "desc": "$tengri$은 $turkic_group$ 및 $mongolian_group$ 민족의 $shamanism_ADJ$ 계열 종교로, 우주를 인격화한 하늘의 신인 $tengri_god_name$를 주신으로 모십니다. 하지만 유일신교는 아니며, 자연과 자연 안에 깃든 여러 신을 숭배하고 선조들을 기리는 등 다양한 신격을 포용합니다."
  },
